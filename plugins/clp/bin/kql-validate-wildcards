#!/usr/bin/env python3
"""
Validate a KQL query for unquoted wildcard values that contain spaces.

clp-s treats `field:*multi word*` as a natural language query and triggers
the semantic fallback.  The correct form is `field:"*multi word*"` — the `*`
wildcard still works inside quotes.

Exit 0 if the query is clean, 1 if offending terms were found.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
from kql_build import unquoted_wildcard_terms  # noqa: E402


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: kql-validate-wildcards <kql-query>", file=sys.stderr)
        return 2

    q = sys.argv[1]

    bad = unquoted_wildcard_terms(q)

    if bad:
        print(
            "error: unquoted wildcard value(s) with spaces — "
            'clp-s treats these as natural language.',
            file=sys.stderr,
        )
        print(
            '  Use field:"*multi word*" not field:*multi word* '
            "(the * wildcard still works inside quotes).",
            file=sys.stderr,
        )
        for term in bad:
            print(f"  Offending: {term!r}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
