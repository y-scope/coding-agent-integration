#!/usr/bin/env python3
"""
kql-build - render structured JSON filters into clp-s KQL, and validate a query
or a log-insights query plan before it is stored or run.

A filter written as JSON cannot produce an unquoted wildcard value or an
ungrouped AND/OR: every string value is quoted and escaped, and every nested
group is parenthesized. The grammar is documented in lib/kql_build.py.

Usage:
  kql-build render [FILTER_JSON]
      Print the KQL for one filter (the argument, or stdin when omitted).
      Example:
        kql-build render '{"all":[{"field":"severity","eq":"WARNING"},
                                  {"field":"message","contains":"SQL txn"}]}'
        -> severity:"WARNING" AND message:"*SQL txn*"

  kql-build validate-wildcards KQL
      Exit 0 if the query holds no unquoted wildcard value with a space in it,
      1 if it does. clp-s reads `field:*multi word*` as a natural language
      query and falls back to semantic search; the correct form is
      `field:"*multi word*"`, where the `*` still works as a wildcard.

  kql-build check-plan FILE [--categories-from CLASSIFICATION_FILE]
                            [--drift-file DRIFT_NDJSON]
                            [--drift-fail-below SHARE]
      Validate every query_plan entry in FILE: a classification JSON object
      with a "query_plan" array, a bare JSON array of entries, or NDJSON with
      one entry per line. Each entry needs a valid "match" filter, a known
      "method", and its ranking: a "category", a "priority" (high, medium,
      low) and a "stage" (core, drill); a hand-written "kql" string is not
      accepted (lib/classification.py). When FILE is a classification object,
      its taxonomy is checked too (every category ranked, with a "why"), and
      each entry's category must be in it. On GROWTH the new classification
      may use the base's categories: --categories-from adds the taxonomy of
      that file to the allowed set. Prints one line per entry, then
      PLAN_CHECK entries=N ok=K invalid=M:
        [i] OK <kql>              valid; <kql> is what the entry runs
        [i] ERROR <label>: <why>  cannot run; <why> says what to fix
        TAXONOMY ERROR <why>      a taxonomy entry lacks its ranking

      --drift-file also checks every entry's filter fields against the archive's
      type drift, the NDJSON that `clp-s-schema-tree --drift --drift-file`
      writes (the insights bootstrap prints its path as TYPE_DRIFT_FILE=).
      clp-s stores one schema-tree node per type, so a field can hold several
      types across records, and a filter reaches the union of a path's scalar
      types but never an Object or an array (lib/plan_drift records the counting
      queries that establish it). A filter at `toolUseResult` therefore answers
      about the 116 records holding a string and says nothing about the 4,525
      holding an object -- silently -- while a filter on `toolUseResult.stderr`
      answers about the 4,525 and not the 116. Each field is checked against its
      own drifting path and its drifting ancestors, in both directions:
        DRIFT_RISK entry=<i> path=<kql_path> at=path|descendant
          types=ClpString:116,Object:4525 dominant=ClpString:116
          addressable=2.5%
                                  at= says which way it was measured, since one
                                  path has a different reachable share per
                                  direction: at=path a filter on that path (it
                                  reaches the scalar types), at=descendant a
                                  filter below it (it reaches the records where
                                  the path is structural). addressable is that
                                  share, dominant its largest reachable type
        DRIFT_DECLARED entry=<i> ... declared=ClpString addressable=2.5%
                                  the filter leaf carries "types": ["ClpString"]
                                  and is for that shape on purpose; the counts
                                  still show what it excludes
        DRIFT_DECLARED_UNVERIFIED entry=<i> path=<field> declared=<types>
          reason=not-in-drift-set
                                  a declaration on a path that does not drift;
                                  the file lists only drifting paths, so a typo
                                  here can be shown but not rejected
      A path a filter reaches whole is not reported at all: ClpString/VarString
      is clp-s splitting one string column, Integer/FormattedFloat one number
      column, and a null answers `field:*` like any other scalar. A DRIFT_RISK
      warns, and fails when `addressable` is below --drift-fail-below (default
      0.95), i.e. when the entry would answer about a minority or a bare
      majority of the path's records. There is no flag to silence it: an entry
      that legitimately targets one shape declares "types" instead, and a
      declaration the data cannot support -- a type the path does not hold, or
      only types a filter at it cannot reach -- is an entry ERROR.
      Closes with DRIFT_CHECKED=<entries> DRIFT_RISK_COUNT=<n>
      DRIFT_DECLARED_COUNT=<n> DRIFT_FAIL_COUNT=<n> (the two counts add up to
      the drift lines printed), or, with no --drift-file,
      DRIFT_CHECK=SKIPPED reason=no-drift-file so the gap is not read as a pass.

Exit codes: 0 every entry OK, 1 any entry ERROR (or an empty plan, or a
DRIFT_RISK below --drift-fail-below), 2 usage or unreadable input.
"""

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
import kql_build  # noqa: E402
import plan_drift  # noqa: E402
from classification import category_names, check_ranked_entry, taxonomy_errors  # noqa: E402
from kql_build import unquoted_wildcard_terms  # noqa: E402

VALUE_OPTIONS = ("--categories-from", "--drift-file", "--drift-fail-below")


def usage(stream):
    print(__doc__.split("Usage:", 1)[1].split("Exit codes:", 1)[0].rstrip(), file=stream)


def load_plan(path):
    """(plan, taxonomy): taxonomy is None unless FILE is a classification object."""
    with open(path, "r", encoding="utf-8") as f:
        text = f.read()
    try:
        obj = json.loads(text)
    except json.JSONDecodeError:
        # Not one JSON document: read it as NDJSON.
        return [json.loads(line) for line in text.splitlines() if line.strip()], None
    if isinstance(obj, dict):
        plan = obj.get("query_plan")
        if not isinstance(plan, list):
            raise ValueError("the JSON object has no 'query_plan' array")
        taxonomy = obj.get("taxonomy")
        return plan, taxonomy if isinstance(taxonomy, list) else None
    if isinstance(obj, list):
        return obj, None
    raise ValueError("expected a JSON object with 'query_plan', a JSON array, or NDJSON")


def parse_check_args(argv):
    """(plan FILE, --categories-from, --drift-file, --drift-fail-below) for
    check-plan; raise ValueError on anything else. Each VALUE_OPTIONS flag takes
    the next argument, in any order, and FILE is the one operand."""
    path, opts, i = None, {}, 0
    while i < len(argv):
        arg = argv[i]
        if arg in VALUE_OPTIONS:
            if i + 1 >= len(argv):
                raise ValueError(f"{arg} needs a value")
            opts[arg] = argv[i + 1]
            i += 2
            continue
        if arg.startswith("-"):
            raise ValueError(f"unknown option {arg}")
        if path is not None:
            raise ValueError("expected one plan FILE")
        path, i = arg, i + 1
    if path is None:
        raise ValueError("expected a plan FILE")
    raw = opts.get("--drift-fail-below")
    if raw is not None and "--drift-file" not in opts:
        raise ValueError("--drift-fail-below needs --drift-file")
    try:
        fail_below = plan_drift.DEFAULT_FAIL_BELOW if raw is None else float(raw)
    except ValueError:
        raise ValueError(f"--drift-fail-below must be a number, got {raw!r}") from None
    if not 0 < fail_below <= 1:
        raise ValueError(f"--drift-fail-below must be in (0, 1], got {fail_below}")
    return path, opts.get("--categories-from"), opts.get("--drift-file"), fail_below


def cmd_render(argv):
    if len(argv) > 1:
        usage(sys.stderr)
        return 2
    raw = argv[0] if argv else sys.stdin.read()
    try:
        node = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(f"error: filter is not valid JSON: {exc}", file=sys.stderr)
        return 2
    try:
        print(kql_build.render(node))
    except kql_build.FilterError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_validate_wildcards(argv):
    """Report every unquoted wildcard value holding a space, in the one KQL operand.

    Exactly one operand, like `render`: a second query would have been accepted
    and never checked, and a validator that silently skips its input is worse
    than one that refuses it.
    """
    if len(argv) != 1:
        print("usage: kql-build validate-wildcards <kql-query>", file=sys.stderr)
        return 2

    bad = unquoted_wildcard_terms(argv[0])

    if bad:
        print(
            "error: unquoted wildcard value(s) with spaces — "
            'clp-s treats these as natural language.',
            file=sys.stderr,
        )
        print(
            '  Use field:"*multi word*" not field:*multi word* '
            "(the * wildcard still works inside quotes).",
            file=sys.stderr,
        )
        for term in bad:
            print(f"  Offending: {term!r}", file=sys.stderr)
        return 1

    return 0


def cmd_check_plan(argv):
    try:
        plan_path, categories_from, drift_path, fail_below = parse_check_args(argv)
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        usage(sys.stderr)
        return 2
    try:
        plan, taxonomy = load_plan(plan_path)
        extra_taxonomy = []
        if categories_from:
            with open(categories_from, "r", encoding="utf-8") as f:
                extra_taxonomy += json.load(f).get("taxonomy", [])
    except (OSError, ValueError, AttributeError) as exc:
        print(f"error: failed to read {plan_path}: {exc}", file=sys.stderr)
        return 2
    drift = None
    if drift_path:
        try:
            drift = plan_drift.load_drift(drift_path)
        except (OSError, ValueError) as exc:
            print(f"error: failed to read {drift_path}: {exc}", file=sys.stderr)
            return 2

    tax_errors = taxonomy_errors(taxonomy) if taxonomy is not None else []
    for line in tax_errors:
        print(f"TAXONOMY ERROR {line}")
    categories = None
    if taxonomy is not None or extra_taxonomy:
        categories = category_names((taxonomy or []) + extra_taxonomy)
    invalid = 0
    checked = risks = declared = fails = 0
    for i, entry in enumerate(plan, 1):
        label = entry.get("label", "") if isinstance(entry, dict) else ""
        try:
            kql = check_ranked_entry(entry, categories)
            lines = []
            if drift is not None:
                # Raises like the checks above when a "types" declaration names
                # a type the path does not hold, so the entry is an ERROR and
                # nothing it reports is counted.
                lines, n_risks, n_declared, n_fails = plan_drift.entry_lines(
                    drift, i, kql_build.filter_fields(entry["match"]), fail_below
                )
                checked += 1
                risks, declared, fails = risks + n_risks, declared + n_declared, fails + n_fails
            print(f"[{i}] OK {kql}")
            for line in lines:
                print(line)
        except kql_build.FilterError as exc:
            invalid += 1
            print(f"[{i}] ERROR {label}: {exc}")
    print(f"PLAN_CHECK entries={len(plan)} ok={len(plan) - invalid} invalid={invalid}"
          + (f" taxonomy_errors={len(tax_errors)}" if tax_errors else ""))
    if drift is None:
        print("DRIFT_CHECK=SKIPPED reason=no-drift-file")
    else:
        print(f"DRIFT_CHECKED={checked} DRIFT_RISK_COUNT={risks} "
              f"DRIFT_DECLARED_COUNT={declared} DRIFT_FAIL_COUNT={fails}")
    return 0 if plan and not invalid and not tax_errors and not fails else 1


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        usage(sys.stdout if argv else sys.stderr)
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "render":
        return cmd_render(rest)
    if cmd == "validate-wildcards":
        return cmd_validate_wildcards(rest)
    if cmd == "check-plan":
        return cmd_check_plan(rest)
    print(f"error: unknown command: {cmd}", file=sys.stderr)
    usage(sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
