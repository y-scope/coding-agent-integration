#!/usr/bin/env bash
set -euo pipefail

CLP_PLUGIN_BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1091
source "${CLP_PLUGIN_BIN_DIR}/lib/clp-common.sh"

usage() {
  cat <<'EOF'
Usage:
  log-shape-insights-bootstrap [options] ARCHIVES_DIR

Mechanical bootstrap for the log-insights skill. One call reads the field
names and per-field value distributions from a sample of records, gets the
per-template frequencies (from the counts stored in the archive), and probes
the classification cache — then prints a compact KEY=VALUE summary.

The first time it sees an archive, it dumps and renders the archive's full log
shape dictionary once and stores each template's hash, count, length and
first --max-chars characters in the cache database (log-shape-cache ingest).
An archive never changes, so a later run on the same archive reads those rows
instead and skips the dump -- unless templates need classifying, whose full
text only the dump has.

It runs in three stages and reports each as it goes. The first stdout line is
an estimate of the whole run from the archive's size and whether it is
stored; on a large archive the first dump takes minutes, so run it in the
background and relay the progress lines.

Options:
  --max-chars N      Character limit the cache fingerprint is computed at
                     (default: 500, or $CLP_LOG_SHAPE_MAX_CHARS). Must match the
                     --max-chars later passed to log-shape-cluster and
                     log-shape-cache, or their fingerprints diverge.
  --out-dir DIR      Where the intermediate files are written (default: /tmp).
  --cache-dir DIR    Classification cache dir (default: log-shape-cache default).
  --sample-cap N     Max records sampled for the value distributions
                     (default: 20000, or $CLP_BOOTSTRAP_SAMPLE_CAP).
  --dump             Dump the dictionary even when the archive is stored, e.g.
                     to get LOG_SHAPES_FILE (the full template text).
  --heartbeat SECONDS
                     While a stage runs, print a progress line every SECONDS
                     (default: 30; 0 prints only stage starts and ends).
  -h, --help         Show this help.

Progress lines printed on stdout as the run goes:
  [bootstrap] archive <size>; expect <estimate>
  [bootstrap] <n>/3 <stage>...            a stage starts
  [bootstrap] <n>/3 <stage>: <s>s elapsed a stage is still running (heartbeat)
  [bootstrap] <n>/3 <stage>: done in <s>s

Summary keys printed on stdout (grep-able):
  ARCHIVE=            archives dir as passed (the search wrapper resolves it)
  ARCHIVE_BYTES=      the archive's size on disk
  ARCHIVE_LOG_SHAPES= log shapes the archives store, from their headers
                      (stats.archives, a tenth of a second) -- the real
                      template count, known before anything is dumped.
                      UNAVAILABLE on a clp-s that predates the query, with
                      ARCHIVE_STATS_HINT= saying so. It counts what the
                      archive stores, so it can exceed LOG_SHAPE_COUNT, which
                      counts the templates the cache keeps apart at MAX_CHARS
  ARCHIVE_VARS=       variables the archives store (same source)
  ARCHIVE_STAT archive_id=... log_shapes=N vars=N
                      the same two numbers per archive, before summing
  ESTIMATE_SECONDS=   expected duration of the whole run, from ARCHIVE_BYTES
                      and ARCHIVE_LOG_SHAPES
  SAMPLE=             one full JSON record (reveals the field names)
  DIST field=... distinct=N sampled=N values="v"(count),...
                      value distribution per top-level scalar field; low
                      distinct => severity/logger-like, high => message-like
  LOG_SHAPE_COUNT=    distinct log shapes in the archive (report to the user)
  SHAPES_SOURCE=      stored (read from the cache database) | dump
  FREQS=              OK | UNAVAILABLE  (UNAVAILABLE: an archive predates the
                      stored per-log-shape counts; FREQS_HINT= says why)
  CACHE_MODE=         UPTODATE | GROWTH | NEW  (from log-shape-cache diff)
  APP_KEY= BASE_KEY=  cache keys (BASE_KEY only on GROWTH)
  TO_CLASSIFY=        number of templates that need classifying (0 on UPTODATE)
  MAX_CHARS=          character limit the fingerprint used; pass the same value
                      to log-shape-cluster and log-shape-cache
  LOG_SHAPES_FILE=    {"log_shape":"..."} NDJSON, the full template text
                      (SHAPES_SOURCE=dump only)
  TO_CLASSIFY_FILE=   the templates to classify (empty on UPTODATE)
  FREQS_FILE=         {"count":N,"hash":"...","length":N,"log_shape":"..."}
                      NDJSON, most frequent first, summed over all archives
                      (FREQS=OK only); "log_shape" is the template's first
                      MAX_CHARS characters, the whole of it when length is no
                      longer
  TYPE_DRIFT_COUNT=   field paths the archive stores under more than one type
                      (clp-s-schema-tree --drift, read off the schema tree
                      already dumped). 0 means no path drifts, which is an
                      answer; UNAVAILABLE means no tree, with TYPE_DRIFT_HINT=
  TYPE_DRIFT_FILE=    {"path","kql_path","types":[{"type","id","count"}],
                      "records"} NDJSON, most records first. A path with both a
                      scalar and an object type is a query trap: a projection
                      or a NOT predicate written for one shape misses the other
  FIELD_COUNT_GROUPS=       distinct record counts the record root's children
                            read (clp-s-schema-tree --field-counts): fields
                            reading the same count are carried by the same
                            records, which is how a block that appears together
                            shows itself
  FIELD_COUNT_NOTE=         these are per-field counts, NOT a partition: a
                            record is counted under every field it carries, so
                            the shares overlap and must never be summed
  FIELD_COUNTS_FILE=        {"count","share","fields":[...],"subtree_nodes"}
                            NDJSON, most records first
  RECORD_FAMILY_COUNT=      families in a verified partition of the records
                            (clp-s-schema-tree --record-families), every pair
                            proved disjoint by counting queries, so these shares
                            do partition the records. UNAVAILABLE with
                            RECORD_FAMILY_HINT= when the queries could not run
  RECORD_FAMILY_METHOD=     value field=F values=N -- the values of one field
                            every record carries, which is exact and costs
                            about 15 queries -- or existence reason=... , which
                            partitions by the subtree a record populates when no
                            such field exists: coarser (a kind of record with no
                            field of its own lands in the residual) and a few
                            hundred queries
  RECORD_FAMILY_RESIDUAL=   records no family matches; the families plus this
                            residual are the whole archive. 0 under the value
                            method. An upper bound if the run hit its query cap,
                            which RECORD_FAMILY_CAP_NOTE in the file says
  RECORD_FAMILY_QUERIES=    counting queries it spent (this step queries; the
                            field counts above do not)
  RECORD_FAMILIES_FILE=     one NDJSON row per family, then the residual, the
                            discarded candidates with the relation that ruled
                            each out, and the subtrees no query can select
  CLASSIFICATION_FILE=      cached plan, fetched for you (UPTODATE only)
  BASE_CLASSIFICATION_FILE= base entry, fetched for you (GROWTH only)
  BOOTSTRAP_TIMINGS sample=Ns dump=Ns cache=Ns total=Ns
                      measured stage durations, to compare with the estimate

Exit codes: 0 summary produced (all FREQS/CACHE_MODE outcomes), 1 archive or
dump failure, 2 usage error.
EOF
}

max_chars="${CLP_LOG_SHAPE_MAX_CHARS:-500}"
out_dir="/tmp"
cache_dir=""
sample_cap="${CLP_BOOTSTRAP_SAMPLE_CAP:-20000}"
heartbeat=30
force_dump=0
archives_dir=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --max-chars)
      [[ $# -ge 2 ]] || { echo "error: --max-chars requires a value" >&2; exit 2; }
      max_chars="$2"; shift 2 ;;
    --out-dir)
      [[ $# -ge 2 ]] || { echo "error: --out-dir requires a value" >&2; exit 2; }
      out_dir="$2"; shift 2 ;;
    --cache-dir)
      [[ $# -ge 2 ]] || { echo "error: --cache-dir requires a value" >&2; exit 2; }
      cache_dir="$2"; shift 2 ;;
    --sample-cap)
      [[ $# -ge 2 ]] || { echo "error: --sample-cap requires a value" >&2; exit 2; }
      sample_cap="$2"; shift 2 ;;
    --dump) force_dump=1; shift ;;
    --heartbeat)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { echo "error: --heartbeat requires a whole number of seconds" >&2; exit 2; }
      heartbeat="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*)
      echo "error: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)
      if [[ -z "$archives_dir" ]]; then archives_dir="$1"; shift
      else echo "error: unexpected argument: $1" >&2; usage >&2; exit 2; fi ;;
  esac
done

[[ -n "$archives_dir" ]] || { usage >&2; exit 2; }
[[ -d "$archives_dir" ]] || { echo "error: not a directory: $archives_dir" >&2; exit 1; }
[[ "$sample_cap" =~ ^[0-9]+$ && "$sample_cap" -gt 0 ]] \
  || { echo "error: --sample-cap must be a positive integer" >&2; exit 2; }
[[ "$max_chars" =~ ^[0-9]+$ && "$max_chars" -gt 0 ]] \
  || { echo "error: --max-chars must be a positive integer" >&2; exit 2; }
mkdir -p "$out_dir"

SEARCH="${CLP_PLUGIN_BIN_DIR}/clp-s-search-kql"
CACHE_BIN="${CLP_PLUGIN_BIN_DIR}/log-shape-cache"
TREE_BIN="${CLP_PLUGIN_BIN_DIR}/clp-s-schema-tree"
cache_args=()
[[ -n "$cache_dir" ]] && cache_args=(--cache-dir "$cache_dir")

log_shapes_file="${out_dir}/log-shapes.ndjson"
to_classify_file="${out_dir}/log-shapes-to-classify.ndjson"
shapes_file="${out_dir}/log-shapes-raw.ndjson"
freqs_file="${out_dir}/log-shape-freqs.ndjson"
err_file="${out_dir}/log-shapes.err"
diff_file="${out_dir}/lt-diff.out"
sample_file="${out_dir}/log-shape-sample.ndjson"
dist_file="${out_dir}/log-shape-dist.txt"
count_file="${out_dir}/log-shape-count.txt"
freqs_unavailable_file="${out_dir}/log-shape-freqs.unavailable"
ingest_file="${out_dir}/log-shape-ingest.out"
ingest_err_file="${out_dir}/log-shape-ingest.err"
tree_raw_file="${out_dir}/log-shape-schema-tree-raw.ndjson"
tree_json_file="${out_dir}/log-shape-schema-tree.json"
tree_summary_file="${out_dir}/log-shape-schema-tree.txt"
template_fields_file="${out_dir}/log-shape-template-fields.ndjson"
archive_stats_file="${out_dir}/log-shape-archive-stats.ndjson"
archive_stats_err_file="${out_dir}/log-shape-archive-stats.err"
type_drift_file="${out_dir}/log-shape-type-drift.ndjson"
field_counts_file="${out_dir}/log-shape-field-counts.ndjson"
record_families_file="${out_dir}/log-shape-record-families.ndjson"
structure_file="${out_dir}/log-shape-structure.txt"
record_families_out_file="${out_dir}/log-shape-record-families.txt"

# --- Stored archives ----------------------------------------------------------
# An archive is immutable. When every archive here was analyzed before, its
# templates' counts, hashes and prefixes are already in the cache database
# (log-shape-cache ingest), and the dictionary is not dumped again. The archive
# ids are the archives' directory names.
archive_ids=()
if looks_like_clp_s_archive_dir "$archives_dir"; then
  archive_ids=("$(basename -- "$(cd -- "$archives_dir" && pwd -P)")")
else
  while IFS= read -r -d '' child; do
    if looks_like_clp_s_archive_dir "$child"; then
      archive_ids+=("$(basename -- "$child")")
    fi
  done < <(find_immediate_children "$archives_dir")
fi
ids_csv="$(IFS=,; printf '%s' "${archive_ids[*]}")"
stored=0
if [[ "$force_dump" -eq 0 && -n "$ids_csv" ]] \
    && "$CACHE_BIN" stored ${cache_args[@]+"${cache_args[@]}"} --max-chars "$max_chars" \
         --archive-ids "$ids_csv" > "$count_file" 2>/dev/null; then
  stored=1
fi

# --- Archive stats -------------------------------------------------------------
# stats.archives reads each archive's header: how many log shapes and how many
# variables it stores. That is the same template count the dictionary dump
# yields, in a tenth of a second instead of about a minute per 300 MiB, so it
# runs before everything else and the estimate below is sized by the number of
# templates that will actually be rendered. A clp-s that predates the query
# fails it; like the per-log-shape counts, that is reported, never fatal.
archive_log_shapes=""
archive_vars=""
if "$SEARCH" "$archives_dir" 'stats.archives' 2>"$archive_stats_err_file" \
     > "$archive_stats_file"; then
  archive_log_shapes="$(grep '^{' "$archive_stats_file" \
    | jq -s 'map(.num_log_shapes // 0) | add' 2>/dev/null || true)"
  archive_vars="$(grep '^{' "$archive_stats_file" \
    | jq -s 'map(.num_vars // 0) | add' 2>/dev/null || true)"
fi
[[ "$archive_log_shapes" =~ ^[0-9]+$ ]] || archive_log_shapes=""
[[ "$archive_vars" =~ ^[0-9]+$ ]] || archive_vars=""

# --- Estimate ------------------------------------------------------------------
# Each search decompresses the archive's segments before it can answer, so the
# run scales with the archive's size; rendering the dictionary scales with the
# number of templates instead. Measured on a 357 MiB CockroachDB archive
# (9.8 GiB of raw logs, 11,558 templates totalling 2.4 GB): 63 s in all when
# the dictionary is dumped (sample 15 s, dump and ingest 40 s, cache probe 7 s),
# 15 s when the archive is stored (the sample, nearly all of it); a 1.6 MB vLLM
# archive takes 1 s either way; an 8.8 MB Claude session archive with 25,524
# templates takes 4 s. Fitting the two dumps gives the two rates below.
# BOOTSTRAP_TIMINGS at the end is there to refine them.
sample_ms_per_mib=45
dump_ms_per_mib=180
dump_us_per_log_shape=100
bootstrap_started="$(date +%s)"
archive_bytes="$(directory_file_bytes "$archives_dir")"
if [[ "$stored" -eq 1 ]]; then
  estimate_seconds=$(( archive_bytes * sample_ms_per_mib / 1000 / 1048576 ))
else
  estimate_seconds=$(( archive_bytes * dump_ms_per_mib / 1000 / 1048576 ))
  if [[ -n "$archive_log_shapes" ]]; then
    estimate_seconds=$(( estimate_seconds
      + archive_log_shapes * dump_us_per_log_shape / 1000000 ))
  fi
fi
[[ "$estimate_seconds" -ge 2 ]] || estimate_seconds=2
if [[ "$estimate_seconds" -lt 60 ]]; then
  estimate_text="under a minute"
else
  estimate_text="about $(( (estimate_seconds + 59) / 60 )) min"
fi
# The template count is the archive's own, so say it rather than guess from
# bytes; a stale clp-s leaves it out of the line.
shapes_text=""
[[ -n "$archive_log_shapes" ]] && shapes_text=", ${archive_log_shapes} log shapes"
if [[ "$stored" -eq 1 ]]; then
  echo "[bootstrap] archive $(human_bytes "$archive_bytes")${shapes_text}, analyzed before; expect ${estimate_text}"
else
  echo "[bootstrap] archive $(human_bytes "$archive_bytes")${shapes_text}; expect ${estimate_text}"
fi
echo "ARCHIVE_BYTES=$archive_bytes"
if [[ -n "$archive_log_shapes" ]]; then
  echo "ARCHIVE_LOG_SHAPES=$archive_log_shapes"
  echo "ARCHIVE_VARS=$archive_vars"
  grep '^{' "$archive_stats_file" | jq -r '
      "ARCHIVE_STAT archive_id=\(.archive_id) log_shapes=\(.num_log_shapes)" +
      " vars=\(.num_vars)"' 2>/dev/null || true
else
  echo "ARCHIVE_LOG_SHAPES=UNAVAILABLE"
  echo "ARCHIVE_STATS_HINT=stats.archives returned no counts (see $archive_stats_err_file); the clp-s binary may predate the query — reinstall the plugin"
fi
echo "ESTIMATE_SECONDS=$estimate_seconds"

# run_stage N LABEL FUNCTION: runs FUNCTION in the background and prints its
# start, a heartbeat every $heartbeat seconds while it runs, and its duration.
# The duration is left in $stage_seconds.
stage_seconds=0
run_stage() {
  local n="$1" label="$2" fn="$3" started pid rc=0 waited
  started="$(date +%s)"
  echo "[bootstrap] ${n}/3 ${label}..."
  "$fn" &
  pid=$!
  trap 'kill "$pid" 2>/dev/null || true' INT TERM
  if [[ "$heartbeat" -gt 0 ]]; then
    while kill -0 "$pid" 2>/dev/null; do
      # Poll in fifths of a second so a quick stage is not held to a whole one.
      waited=0
      while [[ "$waited" -lt $((heartbeat * 5)) ]] && kill -0 "$pid" 2>/dev/null; do
        sleep 0.2
        waited=$((waited + 1))
      done
      kill -0 "$pid" 2>/dev/null || break
      echo "[bootstrap] ${n}/3 ${label}: $(( $(date +%s) - started ))s elapsed"
    done
  fi
  wait "$pid" || rc=$?
  trap - INT TERM
  stage_seconds=$(( $(date +%s) - started ))
  echo "[bootstrap] ${n}/3 ${label}: done in ${stage_seconds}s"
  return "$rc"
}

# --- 1. Schema tree, and a sample for value distributions ----------------------
# Every stage runs in the background (run_stage), so it hands its results to the
# rest of the script through files, not variables.
# The merged schema tree lists every field of the whole archive with its type
# and record count, so the candidate fields come from it rather than from one
# sampled record: a sample from the start of a log can miss whole kinds of
# records. Only the value distributions come from the sample.
# --limit stops the search after $sample_cap records, even on huge archives.
# An empty sample is reported by the emptiness check below.
describe_sample() {
  "$SEARCH" "$archives_dir" 'stats.schema_tree' 2>/dev/null > "$tree_raw_file" || true
  "$TREE_BIN" --tree-file "$tree_raw_file" --json-out "$tree_json_file" "$archives_dir" \
    > "$tree_summary_file" 2>/dev/null || true
  "$SEARCH" --limit "$sample_cap" "$archives_dir" '*' 2>/dev/null > "$sample_file" || true
  [[ -s "$sample_file" ]] || return 0

  local sampled_records field dist distinct values
  sampled_records="$(wc -l < "$sample_file" | tr -d '[:space:]')"

  # Candidate schema fields: the scalar fields outside arrays that the most
  # records carry (cap 8). Severity- and logger-like fields are among them.
  mapfile -t dist_fields < <(jq -r '
      [.[] | select((.type=="VarString" or .type=="Integer" or .type=="Boolean")
                    and (.display | contains("[]") | not) and (has("collapsed_keys") | not))]
      | sort_by(-.records) | .[:8][] | .path' "$tree_json_file" 2>/dev/null)

  for field in "${dist_fields[@]}"; do
    dist="$(jq -r --arg f "$field" 'getpath($f | split(".")) // empty | tostring' "$sample_file" 2>/dev/null \
      | sort | uniq -c | sort -rn)"
    distinct="$(printf '%s\n' "$dist" | grep -c . || true)"
    # Top 8 values as "value"(count), values truncated to 60 chars. Herestring,
    # not a pipe, feeding head: on high-distinct fields (e.g. timestamp) head
    # exits after 8 of ~20k lines and a SIGPIPE'd printf would kill the script
    # under set -e + pipefail (exit 141).
    values="$(head -8 <<<"$dist" \
      | sed -E 's/^[[:space:]]*([0-9]+)[[:space:]](.*)$/\2\t\1/' \
      | awk -F'\t' '{v=$1; if (length(v)>60) v=substr(v,1,60)"…"; printf "%s\"%s\"(%s)", (NR>1?", ":""), v, $2}')"
    echo "DIST field=$field distinct=$distinct sampled=$sampled_records values=$values"
  done > "$dist_file"
}
run_stage 1 "reading the schema tree and a sample of up to ${sample_cap} records" describe_sample
sample_seconds="$stage_seconds"

if [[ ! -s "$sample_file" ]]; then
  echo "error: no records returned from the archive (is $archives_dir a CLP archive dir?)" >&2
  exit 1
fi

echo "ARCHIVE=$archives_dir"
echo "SAMPLE=$(head -1 "$sample_file")"
cat "$dist_file"

# --- 2. Log shape dictionary + per-template frequencies ------------------------
# The counts come from the archive itself, so no record scan is needed. A dump
# is rendered once, by ingest, which also stores the archive for next time.
# On an empty dump, ingest fails and reports it below.
dump_log_shapes() {
  "$SEARCH" "$archives_dir" 'stats.log_shapes' 2>"$err_file" > "$shapes_file" || true
  "$CACHE_BIN" ingest ${cache_args[@]+"${cache_args[@]}"} --max-chars "$max_chars" \
    --shapes-file "$shapes_file" --log-shapes-out "$log_shapes_file" > "$ingest_file" 2>"$ingest_err_file" \
    || return 1
  rm -f "$freqs_unavailable_file"
  if grep -qx 'COUNTS=OK' "$ingest_file"; then
    "$CACHE_BIN" freqs ${cache_args[@]+"${cache_args[@]}"} \
      --archive-ids "$(sed -n 's/^ARCHIVE_IDS=//p' "$ingest_file")" > "$freqs_file"
  else
    : > "$freqs_unavailable_file"
  fi
}
read_stored_freqs() {
  "$CACHE_BIN" freqs ${cache_args[@]+"${cache_args[@]}"} --archive-ids "$ids_csv" > "$freqs_file"
}

# --- 3. Classification-cache probe ---------------------------------------------
probe_cache_file() {
  "$CACHE_BIN" diff ${cache_args[@]+"${cache_args[@]}"} \
    --max-chars "$max_chars" --log-shapes-file "$log_shapes_file" > "$diff_file"
}
# Exits 3 when templates need classifying: only their prefixes are stored. Its
# note says so on stderr; the caller prints its own line, and the file probe
# that follows repeats any cache warning.
probe_cache_stored() {
  "$CACHE_BIN" diff ${cache_args[@]+"${cache_args[@]}"} \
    --max-chars "$max_chars" --archive-ids "$ids_csv" > "$diff_file" 2>/dev/null
}

dump_seconds=0
cache_seconds=0
shapes_source="dump"
freqs="OK"
if [[ "$stored" -eq 1 ]]; then
  run_stage 2 "reading the log shape counts stored for this archive" read_stored_freqs
  dump_seconds=$((dump_seconds + stage_seconds))
  log_shape_count="$(sed -n 's/^LOG_SHAPE_COUNT=//p' "$count_file")"
  probe_rc=0
  run_stage 3 "checking the classification cache" probe_cache_stored || probe_rc=$?
  cache_seconds=$((cache_seconds + stage_seconds))
  if [[ "$probe_rc" -eq 0 ]]; then
    shapes_source="stored"
    # Never leave another archive's full text where this one's would be.
    rm -f "$log_shapes_file"
  elif [[ "$probe_rc" -eq 3 ]]; then
    echo "[bootstrap] templates need classifying, and only their first ${max_chars} characters are stored; dumping the dictionary"
  else
    exit "$probe_rc"
  fi
fi
if [[ "$shapes_source" == "dump" ]]; then
  if ! run_stage 2 "dumping the full log shape dictionary and summing its counts" dump_log_shapes; then
    if [[ -s "$shapes_file" ]]; then
      cat "$ingest_err_file" >&2
    else
      echo "error: stats.log_shapes emitted no log shapes (see $err_file); the clp-s" \
           "binary may predate the shapes API — reinstall the plugin" >&2
    fi
    exit 1
  fi
  dump_seconds=$((dump_seconds + stage_seconds))
  [[ -e "$freqs_unavailable_file" ]] && freqs="UNAVAILABLE"
  # Which fields each template's values came from (clp-s builds that count log
  # shapes per schema-tree node), and the tree summary with per-field values
  # and templates. Both read files already written; neither searches.
  if [[ -s "$tree_raw_file" ]]; then
    "$CACHE_BIN" fields --shapes-file "$shapes_file" --tree-file "$tree_raw_file" \
      > "$template_fields_file" 2>/dev/null || rm -f "$template_fields_file"
    "$TREE_BIN" --tree-file "$tree_raw_file" --log-shapes-file "$shapes_file" \
      --json-out "$tree_json_file" "$archives_dir" > "$tree_summary_file" 2>/dev/null || true
  fi
  log_shape_count="$(sed -n 's/^LOG_SHAPE_COUNT=//p' "$ingest_file")"
  run_stage 3 "checking the classification cache" probe_cache_file
  cache_seconds=$((cache_seconds + stage_seconds))
fi
header="$(head -1 "$diff_file")"
mode="$(printf '%s' "$header" | cut -f1)"
app_key="$(printf '%s' "$header" | cut -f2)"
base_key=""
[[ "$mode" == "GROWTH" ]] && base_key="$(printf '%s' "$header" | cut -f3)"
# grep exits 1 when there is nothing to classify — the normal UPTODATE case.
grep '^{' "$diff_file" > "$to_classify_file" || true
to_classify="$(grep -c '^{' "$to_classify_file" || true)"

# --- Structure: type drift and per-field counts ---------------------------------
# Two more readings of the schema tree dump stage 1 already wrote, so neither
# searches the archive again: the paths stored under more than one type (a query
# written for one of the shapes misses the other), and the record root's children
# grouped by record count. Those counts are per field and overlap -- a record is
# counted under every field it carries -- so they are not a partition; the
# partition is the queried step below.
type_drift_count="UNAVAILABLE"
field_count_groups="UNAVAILABLE"
field_count_note=""
if [[ -s "$tree_raw_file" ]] \
    && "$TREE_BIN" --tree-file "$tree_raw_file" \
         --drift --drift-file "$type_drift_file" \
         --field-counts --field-counts-file "$field_counts_file" \
         "$archives_dir" > "$structure_file" 2>/dev/null; then
  type_drift_count="$(sed -n 's/^DRIFT_COUNT=//p' "$structure_file")"
  field_count_groups="$(sed -n 's/^FIELD_COUNT_GROUPS=//p' "$structure_file")"
  field_count_note="$(sed -n 's/^FIELD_COUNT_NOTE=//p' "$structure_file")"
fi

# --- Record families (the only step here that queries) --------------------------
# The partition the counts above cannot give: one discriminator per child subtree
# of the record root, every pair proved disjoint with a counting query, and the
# records left over reported as the residual. It reuses the same tree dump, so it
# spends no scan -- but it does spend a few hundred counting queries, half a
# minute on a session archive, which is why it says so as it goes. It is
# reported as unavailable rather than failing the run.
record_family_count="UNAVAILABLE"
record_family_residual=""
record_family_queries=""
record_family_method=""
if [[ -s "$tree_raw_file" ]]; then
  families_started="$(date +%s)"
  echo "[bootstrap] partitioning the records into families (counting queries)..."
  if "$TREE_BIN" --tree-file "$tree_raw_file" \
       --record-families --record-families-file "$record_families_file" \
       "$archives_dir" > "$record_families_out_file" 2>/dev/null; then
    record_family_count="$(sed -n 's/^RECORD_FAMILY_COUNT=//p' "$record_families_out_file")"
    record_family_queries="$(sed -n 's/^RECORD_FAMILY_QUERIES=//p' "$record_families_out_file")"
    record_family_residual="$(sed -n 's/^RECORD_FAMILY_RESIDUAL count=\([0-9]*\).*/\1/p' \
      "$record_families_out_file")"
    record_family_method="$(sed -n 's/^RECORD_FAMILY_METHOD=//p' "$record_families_out_file")"
  fi
  if [[ "$record_family_count" =~ ^[0-9]+$ ]]; then
    echo "[bootstrap] record families: ${record_family_count} families," \
         "${record_family_residual} records in the residual," \
         "${record_family_queries} queries in $(( $(date +%s) - families_started ))s"
  else
    echo "[bootstrap] record families: unavailable after" \
         "$(( $(date +%s) - families_started ))s"
  fi
fi

if [[ -s "$tree_summary_file" ]]; then
  grep -E '^TREE_' "$tree_summary_file"
  # The fields most records carry, then every text field (the templated ones).
  grep '^FIELD ' "$tree_summary_file" | grep -v ' type=ClpString ' | head -25 || true
  grep '^FIELD .* type=ClpString ' "$tree_summary_file" | head -40 || true
  grep '^TEXT_FIELDS=' "$tree_summary_file"
  echo "SCHEMA_TREE_FILE=$tree_json_file"
fi
# 0 is an answer here -- no path drifts -- so it is not the unavailable case.
if [[ "$type_drift_count" =~ ^[0-9]+$ ]]; then
  echo "TYPE_DRIFT_COUNT=$type_drift_count"
  echo "TYPE_DRIFT_FILE=$type_drift_file"
else
  echo "TYPE_DRIFT_COUNT=UNAVAILABLE"
  echo "TYPE_DRIFT_HINT=no schema tree for this archive (see $tree_raw_file); the clp-s binary may predate stats.schema_tree — reinstall the plugin"
fi
if [[ "$field_count_groups" =~ ^[0-9]+$ ]]; then
  echo "FIELD_COUNT_GROUPS=$field_count_groups"
  echo "FIELD_COUNT_NOTE=$field_count_note"
  echo "FIELD_COUNTS_FILE=$field_counts_file"
else
  echo "FIELD_COUNT_GROUPS=UNAVAILABLE"
fi
# A partition, unlike the per-field counts above: its shares and the residual
# cover the archive exactly once.
if [[ "$record_family_count" =~ ^[0-9]+$ ]]; then
  echo "RECORD_FAMILY_COUNT=$record_family_count"
  echo "RECORD_FAMILY_METHOD=$record_family_method"
  echo "RECORD_FAMILY_RESIDUAL=$record_family_residual"
  echo "RECORD_FAMILY_QUERIES=$record_family_queries"
  echo "RECORD_FAMILIES_FILE=$record_families_file"
else
  echo "RECORD_FAMILY_COUNT=UNAVAILABLE"
  echo "RECORD_FAMILY_HINT=the counting queries that prove a partition could not run (see $record_families_out_file); the per-field counts in FIELD_COUNTS_FILE overlap and are not a partition"
fi
if [[ -s "$template_fields_file" ]]; then
  echo "TEMPLATE_FIELDS_FILE=$template_fields_file"
else
  echo "TEMPLATE_FIELDS=UNAVAILABLE"
fi
echo "LOG_SHAPE_COUNT=$log_shape_count"
echo "SHAPES_SOURCE=$shapes_source"
echo "FREQS=$freqs"
if [[ "$freqs" == "OK" ]]; then
  echo "FREQS_FILE=$freqs_file"
else
  echo "FREQS_HINT=the archive was compressed by a clp-s build that does not store per-log-shape counts; recompress it with the current plugin"
fi
echo "CACHE_MODE=$mode"
echo "APP_KEY=$app_key"
echo "BASE_KEY=$base_key"
echo "TO_CLASSIFY=$to_classify"
echo "MAX_CHARS=$max_chars"
[[ "$shapes_source" == "dump" ]] && echo "LOG_SHAPES_FILE=$log_shapes_file"
echo "TO_CLASSIFY_FILE=$to_classify_file"

# Fetch the cache entries the next steps need, so the caller doesn't have to.
if [[ "$mode" == "UPTODATE" ]]; then
  "$CACHE_BIN" get "${cache_args[@]}" "$app_key" > "${out_dir}/log-shape-classification.json"
  echo "CLASSIFICATION_FILE=${out_dir}/log-shape-classification.json"
elif [[ "$mode" == "GROWTH" && -n "$base_key" ]]; then
  "$CACHE_BIN" get "${cache_args[@]}" "$base_key" > "${out_dir}/log-shape-base-classification.json"
  echo "BASE_CLASSIFICATION_FILE=${out_dir}/log-shape-base-classification.json"
fi

echo "BOOTSTRAP_TIMINGS sample=${sample_seconds}s dump=${dump_seconds}s cache=${cache_seconds}s" \
     "total=$(( $(date +%s) - bootstrap_started ))s"
