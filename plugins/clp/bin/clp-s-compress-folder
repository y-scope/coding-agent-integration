#!/usr/bin/env bash
set -euo pipefail

CLP_PLUGIN_BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1091
source "${CLP_PLUGIN_BIN_DIR}/lib/clp-common.sh"

usage() {
  cat <<'EOF'
Usage:
  clp-s-compress-folder --path PATH [--path PATH ...] [options]

Compress log files into a searchable CLP archive directory. Each --path is a
log file or a folder of log files; folders are searched for files with the
--extensions below. The files found make up one list, which clp-s compresses:

  clp-s c --remove-path-prefix COMMON_DIR -f FILE_LIST OUTPUT_DIR

Run clp-detect-logs on the same files first: it reads their first lines and
reports the format, the timestamp field, and the flags to pass here.

Options:
  --path PATH                A log file, or a folder of log files. Repeat
                             for more. A file is always included, whatever
                             its extension.
  --extensions EXT,EXT,...   Comma-separated extension filter for folders.
                             Default: log,jsonl,json,txt,ndjson,out,err
                             Use '*' to include every regular file.
  --no-recursive             Search only the top level of each folder.
  --timestamp-key KEY        Pass --timestamp-key KEY to clp-s.
                             No default; only set this if your logs have a
                             known timestamp field.
  --compression-level LEVEL  Pass --compression-level LEVEL to clp-s.
  --target-encoded-size N    Pass --target-encoded-size N to clp-s.
  --output-dir DIR           Top-level archive directory. Overrides
                             --archives-root and saved settings.
  --archives-root DIR        Parent directory for auto-named archive outputs.
                             Default order: this option, CLP_S_ARCHIVES_ROOT,
                             saved config, then ${TMPDIR:-/tmp}/yscope-clp-archives
  --save-archives-root       Save --archives-root as the future default.
  --set-archives-root DIR    Save DIR as the future default and exit.
  --show-archives-root       Print the current archive root setting and exit.
  --print-archive-stats      Pass --print-archive-stats to clp-s.
  --structurize              Pre-process files through structurize.py to
                             convert unstructured text logs into structured
                             JSONL before compression. Automatically sets
                             --timestamp-key timestamp. Files that are already
                             JSON are compressed as they are, never converted.
  --parser FILE              With --structurize: convert text with the
                             parse_line() function in FILE instead of the
                             built-in vLLM formats (see structurize.py).
  --heartbeat SECONDS        While clp-s runs, print a progress line every
                             SECONDS (default: 30; 0 = none): elapsed time,
                             input read so far, archive size so far, and an
                             estimated time left. The same numbers are kept in
                             <archive dir>.compress-status.json, which
                             clp-compress-status reads.
  --dry-run                  Print the planned compression operation only.
                             Read-only: nothing is structurized, staged, or
                             compressed.
  -h, --help                 Show this help.

Without --structurize, a file whose first lines are JSON objects but whose name
is not .json/.jsonl/.ndjson is handed to clp-s as a staged *.jsonl copy: clp-s
picks its parser by file name and would otherwise compress it as text.

Examples:
  clp-s-compress-folder --path /var/log/myapp
  clp-s-compress-folder --path ./vllm_worker_3.log --structurize
  clp-s-compress-folder --path ./a.log --path ./b.log --timestamp-key ts
  clp-s-compress-folder --path ./logs --extensions log,txt
  clp-s-compress-folder --path ./logs --extensions '*' --dry-run
  clp-s-compress-folder --show-archives-root
  clp-s-compress-folder --set-archives-root ~/clp-archives
EOF
}

DEFAULT_EXTENSIONS="log,jsonl,json,txt,ndjson,out,err"

input_paths=()
extensions="$DEFAULT_EXTENSIONS"
extensions_set=0
recursive=1
timestamp_key=""
compression_level=""
target_encoded_size=""
output_dir=""
archives_root=""
archives_root_source=""
archives_root_explicit=0
resolved_archives_root=""
save_archives_root=0
set_archives_root=""
show_archives_root=0
print_archive_stats=0
dry_run=0
heartbeat=30
structurize=0
structurize_passthrough=0
parser_file=""
structurize_tmpdir=""
jsonl_stage_dir=""
jsonl_staged=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --path)
      [[ $# -ge 2 ]] || { echo "error: --path requires a value" >&2; exit 2; }
      input_paths+=("$2")
      shift 2
      ;;
    --extensions)
      [[ $# -ge 2 ]] || { echo "error: --extensions requires a value" >&2; exit 2; }
      extensions="$2"
      extensions_set=1
      shift 2
      ;;
    --no-recursive)
      recursive=0
      shift
      ;;
    --timestamp-key)
      [[ $# -ge 2 ]] || { echo "error: --timestamp-key requires a value" >&2; exit 2; }
      timestamp_key="$2"
      shift 2
      ;;
    --compression-level)
      [[ $# -ge 2 ]] || { echo "error: --compression-level requires a value" >&2; exit 2; }
      compression_level="$2"
      shift 2
      ;;
    --target-encoded-size)
      [[ $# -ge 2 ]] || { echo "error: --target-encoded-size requires a value" >&2; exit 2; }
      target_encoded_size="$2"
      shift 2
      ;;
    --output-dir|--archives-dir)
      [[ $# -ge 2 ]] || { echo "error: $1 requires a value" >&2; exit 2; }
      output_dir="$2"
      shift 2
      ;;
    --archives-root)
      [[ $# -ge 2 ]] || { echo "error: --archives-root requires a value" >&2; exit 2; }
      archives_root="$2"
      archives_root_explicit=1
      shift 2
      ;;
    --save-archives-root)
      save_archives_root=1
      shift
      ;;
    --set-archives-root)
      [[ $# -ge 2 ]] || { echo "error: --set-archives-root requires a value" >&2; exit 2; }
      set_archives_root="$2"
      shift 2
      ;;
    --show-archives-root)
      show_archives_root=1
      shift
      ;;
    --print-archive-stats)
      print_archive_stats=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --heartbeat)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { echo "error: --heartbeat requires a whole number of seconds" >&2; exit 2; }
      heartbeat="$2"
      shift 2
      ;;
    --structurize)
      structurize=1
      shift
      ;;
    --parser)
      [[ $# -ge 2 ]] || { echo "error: --parser requires a value" >&2; exit 2; }
      parser_file="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      echo "error: arbitrary clp-s option passthrough is not exposed by this wrapper" >&2
      exit 2
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      echo >&2
      usage >&2
      exit 2
      ;;
  esac
done

resolve_archives_root() {
  local configured

  if [[ -n "$archives_root" ]]; then
    archives_root_source="argument"
    resolved_archives_root="$(canonicalize_output_path "$archives_root")"
    return $?
  fi
  if [[ -n "${CLP_S_ARCHIVES_ROOT:-}" ]]; then
    archives_root_source="env"
    resolved_archives_root="$(canonicalize_output_path "$CLP_S_ARCHIVES_ROOT")"
    return $?
  fi
  if configured="$(read_configured_archives_root 2>/dev/null)"; then
    archives_root_source="config"
    resolved_archives_root="$(canonicalize_output_path "$configured")"
    return $?
  fi

  archives_root_source="default"
  resolved_archives_root="$(canonicalize_output_path "${TMPDIR:-/tmp}/yscope-clp-archives")"
}

configure_archives_root() {
  local requested="$1"
  local resolved

  resolved="$(canonicalize_output_path "$requested")" || {
    echo "error: archive root parent directory does not exist: $requested" >&2
    exit 1
  }
  if is_broad_output_dir "$resolved"; then
    echo "error: refusing broad archive root: $resolved" >&2
    exit 2
  fi
  mkdir -p "$resolved"
  write_configured_archives_root "$resolved"
  echo "Archives root: $resolved"
  echo "Archives root source: config"
  echo "Config file: $(clp_archives_root_config_file)"
}

if [[ -n "$set_archives_root" ]]; then
  configure_archives_root "$set_archives_root"
  exit 0
fi

if [[ "$save_archives_root" -eq 1 && "$archives_root_explicit" -eq 0 ]]; then
  echo "error: --save-archives-root requires --archives-root DIR" >&2
  exit 2
fi

if [[ "$show_archives_root" -eq 1 ]]; then
  resolve_archives_root || {
    echo "error: archive root parent directory does not exist" >&2
    exit 1
  }
  echo "Archives root: $resolved_archives_root"
  echo "Archives root source: $archives_root_source"
  echo "Config file: $(clp_archives_root_config_file)"
  exit 0
fi

# --- Validate required arguments ---

if [[ "${#input_paths[@]}" -eq 0 ]]; then
  echo "error: --path PATH is required" >&2
  echo >&2
  usage >&2
  exit 2
fi

if [[ -n "$parser_file" ]]; then
  if [[ "$structurize" -eq 0 ]]; then
    echo "error: --parser requires --structurize" >&2
    exit 2
  fi
  if [[ ! -f "$parser_file" || ! -r "$parser_file" ]]; then
    echo "error: --parser is not a readable file: $parser_file" >&2
    exit 1
  fi
  parser_file="$(realpath "$parser_file")"
fi

# Each --path is a file or a folder; work out which.
real_paths=()
path_kinds=()
has_folder=0
for p in "${input_paths[@]}"; do
  if [[ -d "$p" ]]; then
    kind="folder"
    has_folder=1
  elif [[ -f "$p" ]]; then
    kind="file"
  else
    echo "error: --path is not a file or a folder: $p" >&2
    exit 1
  fi
  if [[ ! -r "$p" ]]; then
    echo "error: --path is not readable: $p" >&2
    exit 1
  fi
  real_paths+=("$(realpath "$p")")
  path_kinds+=("$kind")
done
if [[ "$has_folder" -eq 0 && ( "$extensions_set" -eq 1 || "$recursive" -eq 0 ) ]]; then
  echo "error: --extensions and --no-recursive apply only to folders, and every --path is a file" >&2
  exit 2
fi

# The deepest directory holding every path stands in for "the folder": archive
# paths are relative to it, and structurize mirrors the tree below it.
if [[ "${path_kinds[0]}" == "folder" ]]; then
  folder_real="${real_paths[0]}"
else
  folder_real="$(dirname -- "${real_paths[0]}")"
fi
for p in "${real_paths[@]}"; do
  while [[ "$folder_real" != "/" && "$p" != "$folder_real" && "$p" != "$folder_real"/* ]]; do
    folder_real="$(dirname -- "$folder_real")"
  done
done
if [[ "${#real_paths[@]}" -eq 1 ]]; then
  folder_name="$(basename -- "${real_paths[0]}")"
  archive_prefix="${path_kinds[0]}"
else
  # Paths with no common directory but / are named after the first one.
  if [[ "$folder_real" == "/" ]]; then
    folder_name="$(basename -- "${real_paths[0]}")"
  else
    folder_name="$(basename -- "$folder_real")"
  fi
  archive_prefix="paths"
fi
# folder_real is repointed at a staging directory by --structurize and by the
# JSONL sniff below; keep the common directory for the archive metadata.
input_folder="$folder_real"

# --- Validate extensions ---

all_files=0
if [[ "$extensions" == "*" ]]; then
  all_files=1
else
  # Validate each extension is alphanumeric (no wildcards, paths, or dots)
  IFS=',' read -ra ext_array <<< "$extensions"
  for ext in "${ext_array[@]}"; do
    if [[ -z "$ext" ]]; then
      echo "error: empty extension in --extensions list" >&2
      exit 2
    fi
    if [[ "$ext" =~ [^a-zA-Z0-9_] ]]; then
      echo "error: invalid extension (use only alphanumeric/underscore): $ext" >&2
      exit 2
    fi
  done
fi

# --- Resolve output directory ---

if [[ -n "$output_dir" && "$save_archives_root" -eq 1 ]]; then
  echo "error: --save-archives-root cannot be used with --output-dir" >&2
  exit 2
fi

if [[ -n "$output_dir" ]]; then
  output_dir="$(canonicalize_output_path "$output_dir")" || {
    echo "error: output directory parent does not exist: $output_dir" >&2
    exit 1
  }
  if is_broad_output_dir "$output_dir"; then
    echo "error: refusing broad output directory: $output_dir" >&2
    exit 2
  fi
else
  run_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  resolve_archives_root || {
    echo "error: archive root parent directory does not exist" >&2
    exit 1
  }
  if is_broad_output_dir "$resolved_archives_root"; then
    echo "error: refusing broad archive root: $resolved_archives_root" >&2
    exit 2
  fi
  if [[ "$save_archives_root" -eq 1 ]]; then
    mkdir -p "$resolved_archives_root"
    write_configured_archives_root "$resolved_archives_root"
  fi
  output_dir="${resolved_archives_root}/${archive_prefix}-${folder_name}-${run_stamp}"
fi

# --- Discover files ---

file_list="$(mktemp "${TMPDIR:-/tmp}/clp-s-files.XXXXXX")"
trap 'rm -f "$file_list"; [[ -n "${structurize_tmpdir:-}" ]] && rm -rf "${structurize_tmpdir}"; [[ -n "${jsonl_stage_dir:-}" ]] && rm -rf "${jsonl_stage_dir}"' EXIT

find_in_folder() {
  local dir="$1" find_args first ext
  find_args=("$dir")
  if [[ "$recursive" -eq 0 ]]; then
    find_args+=(-maxdepth 1)
  fi
  find_args+=(-type f)
  if [[ "$all_files" -eq 0 ]]; then
    # Extension predicates, case-insensitive
    find_args+=(\()
    first=1
    for ext in "${ext_array[@]}"; do
      if [[ "$first" -eq 1 ]]; then
        find_args+=(-iname "*.${ext}")
        first=0
      else
        find_args+=(-o -iname "*.${ext}")
      fi
    done
    find_args+=(\))
  fi
  find "${find_args[@]}" -print0
}

for i in "${!real_paths[@]}"; do
  if [[ "${path_kinds[$i]}" == "folder" ]]; then
    find_in_folder "${real_paths[$i]}"
  else
    printf '%s\0' "${real_paths[$i]}"
  fi
done > "$file_list"

file_count="$(tr '\0' '\n' < "$file_list" | grep -c . || true)"
if [[ "$file_count" -eq 0 ]]; then
  echo "error: no log files matched in: ${real_paths[*]}" >&2
  if [[ "$all_files" -eq 1 ]]; then
    echo "  (searched all files, recursive=$recursive)" >&2
  else
    echo "  (extensions: $extensions, recursive=$recursive)" >&2
  fi
  exit 1
fi

# --- Give JSONL content a .jsonl name ---
#
# clp-s picks its parser from the file name, so JSONL records in app.log or
# logs.txt are compressed as unstructured text and their fields stay
# unsearchable. Sniff the first lines; when they are JSON objects, hand clp-s a
# staged *.jsonl link instead. Nothing is staged unless a matched file needs it,
# and --structurize rewrites every file under a JSON name anyway.
looks_like_jsonl() {
  local line seen=0
  while IFS= read -r line; do
    [[ -z "${line//[[:space:]]/}" ]] && continue
    seen=$((seen + 1))
    # Only the start of a line: a single record can exceed the sniff window, so
    # its closing brace need not be in the sample.
    [[ "$line" =~ ^[[:space:]]*\{.*\"[^\"]*\"[[:space:]]*: ]] || return 1
    [[ "$seen" -ge 2 ]] && return 0
  done < <(head -c 2097152 -- "$1" 2>/dev/null || true)
  [[ "$seen" -ge 1 ]]
}

needs_jsonl_name() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *.json|*.jsonl|*.ndjson) return 1 ;;
    *) looks_like_jsonl "$1" ;;
  esac
}

stage_jsonl_inputs() {
  local src rel dst
  jsonl_stage_dir="$(mktemp -d "${TMPDIR:-/tmp}/clp-s-jsonl.XXXXXX")"
  staged_list="$(mktemp "${TMPDIR:-/tmp}/clp-s-files.XXXXXX")"
  while IFS= read -r -d '' src; do
    # Mirror the source tree, as --structurize does, so same-named files in
    # different subdirectories stay distinct.
    rel="${src#"${folder_real%/}"/}"
    dst="${jsonl_stage_dir}/${rel}"
    if needs_jsonl_name "$src"; then
      dst="${dst}.jsonl"
      jsonl_staged=$((jsonl_staged + 1))
    fi
    while [[ -e "$dst" ]]; do dst="${dst}.dup"; done
    mkdir -p "$(dirname -- "$dst")"
    # A hard link costs nothing; fall back to a copy when the staging dir is on
    # another filesystem (TMPDIR on tmpfs, for instance).
    ln -- "$src" "$dst" 2>/dev/null || cp -p -- "$src" "$dst"
    printf '%s\0' "$dst" >> "$staged_list"
  done < "$file_list"
  rm -f "$file_list"
  file_list="$staged_list"
  folder_real="$jsonl_stage_dir"
}

is_json_input() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *.json|*.jsonl|*.ndjson) return 0 ;;
    *) looks_like_jsonl "$1" ;;
  esac
}

if [[ "$structurize" -eq 0 && "$dry_run" -eq 1 ]]; then
  # Read-only: count what staging would rename, but stage nothing.
  while IFS= read -r -d '' src_path; do
    if needs_jsonl_name "$src_path"; then
      jsonl_staged=$((jsonl_staged + 1))
    fi
  done < "$file_list"
elif [[ "$structurize" -eq 0 ]]; then
  stage_needed=0
  while IFS= read -r -d '' src_path; do
    if needs_jsonl_name "$src_path"; then
      stage_needed=1
      break
    fi
  done < "$file_list"
  if [[ "$stage_needed" -eq 1 ]]; then
    stage_jsonl_inputs
  fi
fi

# --- Structurize unstructured logs ---
#
# Each text file is converted to JSONL by structurize.py: with its built-in vLLM
# formats, or with the parser program named by --parser. A file that is already
# JSON is never converted; it goes in as it is. A dry run converts nothing.

if [[ "$structurize" -eq 1 && "$dry_run" -eq 1 ]]; then
  structurize_would=0
  while IFS= read -r -d '' src_path; do
    if is_json_input "$src_path"; then
      structurize_passthrough=$((structurize_passthrough + 1))
    else
      structurize_would=$((structurize_would + 1))
    fi
  done < "$file_list"
  [[ -n "$timestamp_key" ]] || timestamp_key="timestamp"
elif [[ "$structurize" -eq 1 ]]; then
  structurize_script="${CLP_PLUGIN_BIN_DIR}/structurize.py"
  if [[ ! -f "$structurize_script" ]]; then
    echo "error: --structurize requires structurize.py but it was not found: $structurize_script" >&2
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "error: --structurize requires python3 but it is not installed" >&2
    exit 1
  fi
  structurize_args=()
  [[ -n "$parser_file" ]] && structurize_args=(--parser "$parser_file")

  structurize_tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/clp-s-structurize.XXXXXX")"
  structurize_ok=0
  structurize_skip=0
  new_file_list="$(mktemp "${TMPDIR:-/tmp}/clp-s-files.XXXXXX")"
  original_folder_real="$folder_real"

  while IFS= read -r -d '' src_path; do
    # Mirror the source tree under the temp dir. Using only the basename would
    # collapse same-named files from different subdirectories (recursion is the
    # default), silently dropping all but one and duplicating it in the archive.
    rel_path="${src_path#"${original_folder_real%/}"/}"
    if is_json_input "$src_path"; then
      dst_path="${structurize_tmpdir}/${rel_path}"
      needs_jsonl_name "$src_path" && dst_path="${dst_path}.jsonl"
      mkdir -p "$(dirname -- "$dst_path")"
      ln -- "$src_path" "$dst_path" 2>/dev/null || cp -p -- "$src_path" "$dst_path"
      printf '%s\0' "$dst_path" >> "$new_file_list"
      structurize_passthrough=$((structurize_passthrough + 1))
      echo "[structurize] $rel_path: already JSON, compressed as it is"
      continue
    fi
    dst_path="${structurize_tmpdir}/${rel_path}.json"
    mkdir -p "$(dirname -- "$dst_path")"
    err_file="${structurize_tmpdir}/.err"
    started="$(date +%s)"
    if out="$(python3 "$structurize_script" ${structurize_args[@]+"${structurize_args[@]}"} "$src_path" "$dst_path" 2>"$err_file")"; then
      if [[ -s "$dst_path" ]]; then
        printf '%s\0' "$dst_path" >> "$new_file_list"
        structurize_ok=$((structurize_ok + 1))
        records="$(printf '%s\n' "$out" | grep -oE '[0-9]+ structured' | grep -oE '[0-9]+' | head -1 || true)"
        echo "[structurize] $rel_path: ${records:-?} records in $(( $(date +%s) - started ))s"
      else
        echo "warning: structurize produced empty output for $rel_path, skipping" >&2
        structurize_skip=$((structurize_skip + 1))
      fi
    else
      reason="$(head -1 "$err_file")"
      [[ "$reason" == Traceback* ]] && reason="$(tail -1 "$err_file")"
      echo "warning: structurize failed for $rel_path, skipping: $reason" >&2
      structurize_skip=$((structurize_skip + 1))
    fi
  done < "$file_list"
  rm -f "${structurize_tmpdir}/.err"

  if [[ "$structurize_ok" -eq 0 && "$structurize_passthrough" -eq 0 ]]; then
    echo "error: structurize did not produce any output files" >&2
    rm -f "$new_file_list"
    exit 1
  fi

  if [[ "$structurize_skip" -gt 0 ]]; then
    echo "warning: structurize skipped $structurize_skip file(s); proceeding with $((structurize_ok + structurize_passthrough)) file(s)" >&2
  fi

  # Replace file list with structurize output
  rm -f "$file_list"
  file_list="$new_file_list"

  # Point remove-path-prefix at the structurize temp dir so archive paths
  # show just the filename (e.g. "app.log.json") instead of a deep tmp path
  folder_real="$structurize_tmpdir"

  # Recompute file count from the structurized list
  file_count=$((structurize_ok + structurize_passthrough))

  # Auto-set timestamp key for structured JSONL output
  if [[ -z "$timestamp_key" ]]; then
    timestamp_key="timestamp"
  fi

  echo "Structurize: converted $structurize_ok file(s) to structured JSONL"
  if [[ "$structurize_passthrough" -gt 0 ]]; then
    echo "Structurize passed through: $structurize_passthrough JSON file(s)"
  fi
  if [[ "$structurize_skip" -gt 0 ]]; then
    echo "Structurize skipped: $structurize_skip file(s)"
  fi
fi

# clp-s -f expects a NEWLINE-delimited file list. The list above is
# null-delimited (built with `find -print0` / `printf '%s\0'` to survive
# filenames containing spaces). Convert it to newline-delimited here so
# clp-s ingests EVERY file — otherwise it reads only the first null-terminated
# entry and silently drops the rest of the folder. (Log filenames do not
# contain newlines, so this conversion is safe.)
nl_file_list="$(mktemp "${TMPDIR:-/tmp}/clp-s-files.XXXXXX")"
tr '\0' '\n' < "$file_list" > "$nl_file_list"
rm -f "$file_list"
file_list="$nl_file_list"

# Compute total bytes
total_bytes=0
while IFS= read -r path; do
  size="$(wc -c < "$path" | tr -d '[:space:]')"
  total_bytes=$((total_bytes + size))
done < "$file_list"

# --- Build clp-s command ---

clp_s_bin="$(resolve_clp_s)" || exit $?

cmd=("$clp_s_bin" c)
if [[ -n "$timestamp_key" ]]; then
  cmd+=(--timestamp-key "$timestamp_key")
fi
if [[ -n "$compression_level" ]]; then
  cmd+=(--compression-level "$compression_level")
fi
if [[ -n "$target_encoded_size" ]]; then
  cmd+=(--target-encoded-size "$target_encoded_size")
fi
if [[ "$print_archive_stats" -eq 1 ]]; then
  cmd+=(--print-archive-stats)
fi
cmd+=(--remove-path-prefix "$folder_real")
cmd+=(-f "$file_list" "$output_dir")

# --- Plan / dry-run output ---

for i in "${!real_paths[@]}"; do
  echo "Path: ${real_paths[$i]} (${path_kinds[$i]})"
done
if [[ "$has_folder" -eq 1 ]]; then
  echo "Extensions: $extensions"
  echo "Recursive: $([ "$recursive" -eq 1 ] && echo 'yes' || echo 'no')"
fi
echo "Input files: $file_count"
echo "Input bytes: $total_bytes"
if [[ -n "${resolved_archives_root:-}" ]]; then
  echo "Archives root: $resolved_archives_root"
  echo "Archives root source: $archives_root_source"
fi
echo "Archives dir: $output_dir"
echo "Timestamp key: ${timestamp_key:-none}"
if [[ "$structurize" -eq 1 && "$dry_run" -eq 1 ]]; then
  echo "Structurize: yes, $structurize_would file(s) to convert${parser_file:+ with $parser_file}, $structurize_passthrough JSON file(s) as they are (nothing converted in a dry run)"
else
  echo "Structurize: $([ "$structurize" -eq 1 ] && echo "yes${parser_file:+ (parser: $parser_file)}" || echo 'no')"
fi
if [[ "$jsonl_staged" -gt 0 && "$dry_run" -eq 1 ]]; then
  echo "JSONL staged: $jsonl_staged file(s) would be renamed to .jsonl (content does not match the extension)"
elif [[ "$jsonl_staged" -gt 0 ]]; then
  echo "JSONL staged: $jsonl_staged file(s) renamed to .jsonl (content did not match the extension)"
fi
echo "Archive mode: regular directory archive (--single-file-archive disabled)"
printf 'Command:'
printf ' %q' "${cmd[@]}"
echo

if [[ "$dry_run" -eq 1 ]]; then
  echo "Dry run only; nothing was converted, staged, or compressed."
  exit 0
fi

# --- Run compression ---

mkdir -p "$output_dir"

# clp-s runs in the background so this script can report progress: a compression
# of a multi-GB log takes minutes and prints nothing itself. Progress is the
# bytes the process has read (/proc/PID/io, Linux only) over the input size. The
# status file sits beside the archive directory, so it never changes the archive
# size reported below.
status_file="${output_dir%/}.compress-status.json"
compress_started="$(date +%s)"
comp_pid=0
read_bytes=0

write_compress_status() {
  local state="$1" exit_code="${2:-null}"
  jq -n \
    --arg state "$state" \
    --argjson pid "$comp_pid" \
    --argjson startedAt "$compress_started" \
    --argjson updatedAt "$(date +%s)" \
    --argjson inputBytes "$total_bytes" \
    --argjson readBytes "$read_bytes" \
    --argjson archiveBytes "$(directory_file_bytes "$output_dir")" \
    --argjson exitCode "$exit_code" \
    '{state: $state, pid: $pid, startedAt: $startedAt, updatedAt: $updatedAt,
      inputBytes: $inputBytes, readBytes: $readBytes, archiveBytes: $archiveBytes,
      exitCode: $exitCode}' > "$status_file.tmp" && mv "$status_file.tmp" "$status_file"
}

"${cmd[@]}" &
comp_pid=$!
trap 'kill "$comp_pid" 2>/dev/null || true' INT TERM
write_compress_status running

if [[ "$heartbeat" -gt 0 ]]; then
  while kill -0 "$comp_pid" 2>/dev/null; do
    waited=0
    while [[ "$waited" -lt "$heartbeat" ]] && kill -0 "$comp_pid" 2>/dev/null; do
      sleep 1
      waited=$((waited + 1))
    done
    kill -0 "$comp_pid" 2>/dev/null || break
    read_bytes="$(awk '/^rchar:/ { print $2 }' "/proc/$comp_pid/io" 2>/dev/null || true)"
    read_bytes="${read_bytes:-0}"
    [[ "$read_bytes" -le "$total_bytes" ]] || read_bytes="$total_bytes"
    elapsed=$(( $(date +%s) - compress_started ))
    archive_so_far="$(directory_file_bytes "$output_dir")"
    line="[compress] ${elapsed}s elapsed"
    if [[ "$read_bytes" -gt 0 && "$total_bytes" -gt 0 ]]; then
      line+=", $(human_bytes "$read_bytes") of $(human_bytes "$total_bytes") read ($(( read_bytes * 100 / total_bytes ))%)"
      line+=", about $(( elapsed * (total_bytes - read_bytes) / read_bytes ))s left"
    fi
    line+=", archive $(human_bytes "$archive_so_far") so far"
    echo "$line"
    write_compress_status running
  done
fi

compress_rc=0
wait "$comp_pid" || compress_rc=$?
trap - INT TERM
if [[ "$compress_rc" -ne 0 ]]; then
  write_compress_status failed "$compress_rc"
  echo "error: clp-s exited with status $compress_rc" >&2
  exit "$compress_rc"
fi
read_bytes="$total_bytes"
write_compress_status done 0

# --- Compute stats and write metadata ---

archive_bytes="$(directory_file_bytes "$output_dir")"
compression_ratio="$(awk -v raw="$total_bytes" -v archive="$archive_bytes" 'BEGIN { if (archive > 0) printf "%.2fx", raw / archive; else printf "n/a" }')"
reduction_bytes=$((total_bytes - archive_bytes))
reduction_percent="$(awk -v raw="$total_bytes" -v reduction="$reduction_bytes" 'BEGIN { if (raw > 0) printf "%.2f%%", reduction * 100 / raw; else printf "n/a" }')"
clp_archive_dir="$(resolve_clp_s_archive_dir "$output_dir" 2>/dev/null || true)"

# Build extensions JSON array
paths_json="$(printf '%s\n' "${real_paths[@]}" | jq -R . | jq -s .)"
source_type="$archive_prefix"
if [[ "$has_folder" -eq 0 ]]; then
  extensions_json='null'
elif [[ "$all_files" -eq 1 ]]; then
  extensions_json='"*"'
else
  extensions_json="$(printf '%s\n' "${ext_array[@]}" | jq -R . | jq -s .)"
fi

metadata_file="$(clp_archive_metadata_file "$output_dir")"
command_json="$(printf '%s\n' "${cmd[@]}" | jq -R . | jq -s .)"
jq -n \
  --arg schemaVersion "1" \
  --arg createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --arg plugin "yscope-clp" \
  --arg sourceType "$source_type" \
  --argjson sourcePaths "$paths_json" \
  --arg parser "$parser_file" \
  --arg sourcePath "$input_folder" \
  --arg sourceName "$folder_name" \
  --argjson sourceRecursive "$([[ "$has_folder" -eq 1 ]] && echo "$recursive" || echo null)" \
  --argjson sourceExtensions "$extensions_json" \
  --argjson sourceFileCount "$file_count" \
  --arg archiveRoot "${resolved_archives_root:-}" \
  --arg archiveRootSource "${archives_root_source:-output-dir}" \
  --arg archiveDir "$output_dir" \
  --arg clpArchiveDir "$clp_archive_dir" \
  --arg timestampKey "${timestamp_key:-}" \
  --argjson inputBytes "$total_bytes" \
  --argjson archiveBytes "$archive_bytes" \
  --argjson reductionBytes "$reduction_bytes" \
  --arg compressionRatio "$compression_ratio" \
  --arg reductionPercent "$reduction_percent" \
  --argjson command "$command_json" \
  --argjson structurizeFlag "$structurize" \
  '{
    schemaVersion: ($schemaVersion | tonumber),
    createdAt: $createdAt,
    plugin: $plugin,
    source: {
      type: $sourceType,
      path: $sourcePath,
      name: $sourceName,
      recursive: $sourceRecursive,
      extensions: $sourceExtensions,
      paths: $sourcePaths,
      fileCount: $sourceFileCount
    },
    archiveRoot: (if $archiveRoot == "" then null else $archiveRoot end),
    archiveRootSource: $archiveRootSource,
    archiveDir: $archiveDir,
    clpArchiveDir: (if $clpArchiveDir == "" then null else $clpArchiveDir end),
    timestampKey: (if $timestampKey == "" then null else $timestampKey end),
    structurize: ($structurizeFlag == 1),
    parser: (if $parser == "" then null else $parser end),
    compression: {
      rawBytes: $inputBytes,
      archiveBytes: $archiveBytes,
      ratio: $compressionRatio,
      reductionBytes: $reductionBytes,
      reductionPercent: $reductionPercent
    },
    command: $command
  }' > "$metadata_file"

echo "Raw input bytes: $total_bytes"
echo "Archive bytes: $archive_bytes"
echo "Compression ratio: $compression_ratio"
echo "File size reduction: $reduction_bytes bytes ($reduction_percent)"
echo "Input files: $file_count"
if [[ "$structurize" -eq 1 ]]; then
  echo "Structurize: yes (converted to structured JSONL)"
fi
if [[ -n "$clp_archive_dir" && "$clp_archive_dir" != "$output_dir" ]]; then
  echo "Resolved clp-s archive dir: $clp_archive_dir"
fi
echo "Archive metadata: $metadata_file"
echo "Archive entries:"
while IFS= read -r -d '' entry; do
  entry_type="$(file_type_letter "$entry")"
  entry_size="$(file_size_bytes "$entry" 2>/dev/null || printf '0')"
  printf '%s\t%s\t%s bytes\n' "$entry" "$entry_type" "$entry_size"
done < <(find_immediate_children "$output_dir") | LC_ALL=C sort