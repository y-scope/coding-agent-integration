#!/usr/bin/env bash
set -euo pipefail

CLP_PLUGIN_BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1091
source "${CLP_PLUGIN_BIN_DIR}/lib/clp-common.sh"

usage() {
  cat <<'EOF'
Usage:
  clp-s-search-kql [options] ARCHIVES_DIR KQL_QUERY

Run a restricted clp-s KQL search and return results on stdout.

ARCHIVES_DIR may be one archive, a directory holding one archive, or a directory
holding several (for example a bundle of logs compressed into one --output-dir).
With several, each archive is searched in turn and the results are concatenated;
--count and --unique rows carry "archive_id", --limit caps the total, and
--archive-id picks one archive.

Allowed search controls:
  --tge TS                 Find records with UNIX epoch timestamp >= TS ms.
  --tle TS                 Find records with UNIX epoch timestamp <= TS ms.
  -i, --ignore-case        Ignore case distinctions.
  --archive-id ID          Limit search to one archive ID.
  --with-archive           Wrap each record as {"archive_id":ID,"record":{...}} so a
                           hit says which archive it came from (the record itself is
                           untouched). --count, --unique and stats queries already
                           carry archive_id and are left as they are.
  --projection COLUMNS     Project comma-separated columns, e.g. level,message.
                           May be repeated. Mutually exclusive with --count
                           and --unique.
  --count                  Count matching records with clp-s's in-engine
                           aggregation; no per-record JSON is serialized, so
                           it is far cheaper than projecting and piping to
                           `grep -c '^{'` when many records match (measured:
                           ~6-7s whether a filter matched 92 or 16.5M records
                           of a 16.5M-record archive). Prints NOTHING when zero
                           records match; treat empty output as a real zero.
  --unique FIELD           List the distinct values of FIELD among matches with
                           clp-s's in-engine aggregation. Still scans the
                           matching records (measured: ~84s for a
                           low-cardinality field over 16.5M records), but beats
                           projecting and running sort | uniq.
  --limit N                Stop after N matching records. Which N come back is
                           unspecified (not the earliest or latest), so use it
                           for examples, never for counts. It always caps the
                           output size. It only saves time when the limit is
                           reached before later schema tables or archives are
                           read: clp-s decompresses a whole table before
                           returning its first record, so on an archive whose
                           records sit in one large table, --limit 1 costs
                           about as much as a full scan.
                           --count, --unique, and --limit are mutually
                           exclusive.
  --semantic-endpoint URL  Embedding server URL for semantic search. Defaults
                           to $CLP_SEMANTIC_ENDPOINT, then the semantic-endpoint
                           config file, then the built-in remote endpoints.
  --semantic-top-k K       Return up to K nearest log shapes (default 5).
  --semantic-threshold T   Minimum similarity floor 0.0-1.0 (default 0.3).
  --embedding-batch-size N  Batch size for vector processing (default auto).
  --experimental          Enable clp-s experimental (clpp) features. Required
                           for shape()/decompose() KQL functions.
  --clp-s-bin PATH        Use this clp-s binary for this invocation only.
                           Overrides the CLP_S_BIN env var and the installed
                           plugin binary; useful for pointing at a local build.

Examples:
  clp-s-search-kql /tmp/archive 'level:error'
  clp-s-search-kql /tmp/archive 'message.content.name:Bash'
  clp-s-search-kql /tmp/archive 'semantic("slow database queries")'
  clp-s-search-kql --projection timestamp,type,sessionId /tmp/archive 'message.content.name:Bash'
  clp-s-search-kql /tmp/archive 'stats.log_shapes'
  clp-s-search-kql --experimental /tmp/archive 'shape(message): "*error*"'
  clp-s-search-kql --experimental --projection 'shape(message)' /tmp/archive '*'
  clp-s-search-kql --experimental --projection 'decompose(message)' /tmp/archive '*'

Stats queries (dictionary dumps, not KQL): 'stats.log_shapes' emits the
archive's log shape dictionary as NDJSON ({"archive_id","count","id","shape"});
'stats.schema_tree' and 'stats.archives' emit schema and archive metadata.
These require the shapes API (clp-core >= 0.13); the wrapper adds
--experimental so clpp archives open too. `count` is how many values carried
the shape, stored at compression time (null for archives compressed before
clp-s stored it). Shapes mark variables as %int%/%str%/%float% on regular
archives and %rule.name% on clpp archives (older builds emit raw placeholder
bytes); `log-shape-cache normalize` renders all of them to '<*>', and
`log-shape-cache freqs` sums the counts per template. The legacy
'stats.logtypes' query is rejected — shapes-API binaries silently return
nothing for it.

This search wrapper intentionally does not expose clp-s output handlers,
reducers, results-cache writes, decompression, or arbitrary clp-s option
passthrough.

Semantic search uses semantic("query") in KQL and requires a reachable embedding
server. This wrapper never starts one — point it at a server that is already
running. The endpoint is resolved by precedence, and health-checked before the
search:
  1. --semantic-endpoint URL
  2. $CLP_SEMANTIC_ENDPOINT
  3. the semantic-endpoint config file
     (~/.config/yscope-clp-plugin/semantic-endpoint, one URL per line;
      blank lines and #comments ignored; override the path with
      $CLP_SEMANTIC_ENDPOINT_FILE)
  4. the built-in remote endpoint
     (https://ca-central-semantic-cache.yscope.ai)
An endpoint named by 1-3 that fails its health check is a hard error; only the
built-in defaults in 4 are probed and skipped. A server you host yourself
(including on localhost) must be named explicitly — it is not auto-detected.
EOF
}

tge=""
tle=""
archive_id=""
limit=""
count_mode=0
unique_field=""
ignore_case=0
with_archive=0
projections=()
archives_dir=""
kql_query=""
semantic_endpoint=""
semantic_top_k=""
semantic_threshold=""
embedding_batch_size=""
semantic_active=0
experimental=0
clp_s_bin_override=""

split_projection_csv() {
  local value="$1"
  local item
  IFS=',' read -ra cols <<< "$value"
  for item in "${cols[@]}"; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    if [[ -z "$item" ]]; then
      continue
    fi
    # Projection items are appended to argv after --projection, which clp-s
    # treats as variadic — an item starting with '-' would be parsed as a
    # clp-s option, bypassing this wrapper's flag allowlist (e.g. smuggling
    # --enable-telemetry or --count). No real column starts with '-'.
    if [[ "$item" == -* ]]; then
      echo "error: invalid projection column: $item" >&2
      exit 2
    fi
    projections+=("$item")
  done
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --semantic-endpoint)
      [[ $# -ge 2 ]] || { echo "error: --semantic-endpoint requires a value" >&2; exit 2; }
      semantic_endpoint="$2"
      semantic_active=1
      shift 2
      ;;
    --semantic-top-k)
      [[ $# -ge 2 ]] || { echo "error: --semantic-top-k requires a value" >&2; exit 2; }
      semantic_top_k="$2"
      semantic_active=1
      shift 2
      ;;
    --semantic-threshold)
      [[ $# -ge 2 ]] || { echo "error: --semantic-threshold requires a value" >&2; exit 2; }
      semantic_threshold="$2"
      semantic_active=1
      shift 2
      ;;
    --embedding-batch-size)
      [[ $# -ge 2 ]] || { echo "error: --embedding-batch-size requires a value" >&2; exit 2; }
      embedding_batch_size="$2"
      semantic_active=1
      shift 2
      ;;
    --tge)
      [[ $# -ge 2 ]] || { echo "error: --tge requires a value" >&2; exit 2; }
      tge="$2"
      shift 2
      ;;
    --tle)
      [[ $# -ge 2 ]] || { echo "error: --tle requires a value" >&2; exit 2; }
      tle="$2"
      shift 2
      ;;
    --archive-id)
      [[ $# -ge 2 ]] || { echo "error: --archive-id requires a value" >&2; exit 2; }
      archive_id="$2"
      shift 2
      ;;
    --projection)
      [[ $# -ge 2 ]] || { echo "error: --projection requires a value" >&2; exit 2; }
      split_projection_csv "$2"
      shift 2
      ;;
    --limit)
      [[ $# -ge 2 ]] || { echo "error: --limit requires a value" >&2; exit 2; }
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || { echo "error: --limit must be a positive integer" >&2; exit 2; }
      limit="$2"
      shift 2
      ;;
    --count)
      count_mode=1
      shift
      ;;
    --unique)
      [[ $# -ge 2 ]] || { echo "error: --unique requires a field name" >&2; exit 2; }
      [[ "$2" != -* ]] || { echo "error: invalid --unique field: $2" >&2; exit 2; }
      unique_field="$2"
      shift 2
      ;;
    -i|--ignore-case)
      ignore_case=1
      shift
      ;;
    --with-archive)
      with_archive=1
      shift
      ;;
    --experimental)
      experimental=1
      shift
      ;;
    --clp-s-bin)
      [[ $# -ge 2 ]] || { echo "error: --clp-s-bin requires a value" >&2; exit 2; }
      clp_s_bin_override="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      echo "error: arbitrary clp-s option passthrough is not exposed by this wrapper" >&2
      exit 2
      ;;
    -*)
      echo "error: unsupported option: $1" >&2
      echo >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -z "$archives_dir" ]]; then
        archives_dir="$1"
      elif [[ -z "$kql_query" ]]; then
        kql_query="$1"
      else
        echo "error: unexpected positional argument: $1" >&2
        exit 2
      fi
      shift
      ;;
  esac
done

if [[ -z "$archives_dir" || -z "$kql_query" ]]; then
  usage >&2
  exit 2
fi

num_output_modes=$(( count_mode + (${#unique_field} > 0) + (${#limit} > 0) ))
if [[ "$num_output_modes" -gt 1 ]]; then
  echo "error: --count, --unique, and --limit are mutually exclusive" >&2
  exit 2
fi
if [[ ( "$count_mode" -eq 1 || -n "$unique_field" ) && ${#projections[@]} -gt 0 ]]; then
  echo "error: --count and --unique cannot be combined with --projection" >&2
  exit 2
fi

# Stats queries (clp-core >= 0.13 shapes API). The binary requires
# --experimental for these, so add it on the caller's behalf; and the legacy
# stats.logtypes spelling silently matches nothing on shapes-API binaries, so
# reject it with the rename instead of returning a confusingly empty result.
# The binary matches stats directives exactly (unlike KQL, it does not trim
# whitespace), so trim the query before dispatching AND pass the trimmed form
# to clp-s — a stray trailing space would otherwise silently return 0 rows.
trimmed_query="${kql_query#"${kql_query%%[![:space:]]*}"}"
trimmed_query="${trimmed_query%"${trimmed_query##*[![:space:]]}"}"
case "$trimmed_query" in
  stats.log_shapes|stats.schema_tree|stats.archives)
    experimental=1
    kql_query="$trimmed_query"
    ;;
  stats.logtypes)
    echo "error: stats.logtypes was renamed to stats.log_shapes (clp-core >= 0.13 shapes API)." >&2
    echo "  Dump the dictionary with:  clp-s-search-kql ARCHIVE 'stats.log_shapes'" >&2
    echo "  then render placeholders:  ... | log-shape-cache normalize" >&2
    exit 2
    ;;
esac

if [[ "$kql_query" =~ [Ss][Ee][Mm][Aa][Nn][Tt][Ii][Cc][[:space:]]*\( ]]; then
  semantic_active=1
fi

# Catch unquoted wildcard values that contain spaces, e.g. field:*multi word* — clp-s
# treats those as natural language and triggers the semantic fallback, which errors when
# no endpoint is active. The fix is always field:"*multi word*".
"$(dirname "$0")/kql-validate-wildcards" "$kql_query" || exit 2

# Per-invocation binary override composes with the CLP_S_BIN env var already
# honored by resolve_clp_s; the flag wins for this invocation only.
if [[ -n "$clp_s_bin_override" ]]; then
  export CLP_S_BIN="$clp_s_bin_override"
fi

clp_s_bin="$(resolve_clp_s)" || exit $?

if [[ ! -e "$archives_dir" ]]; then
  echo "error: archives path does not exist: $archives_dir" >&2
  exit 1
fi
# Header lines go to stderr so stdout carries only clp-s JSON results.
print_archive_metadata_summary "$archives_dir" >&2
input_archives_dir="$archives_dir"
# Both stable and --experimental (clpp) paths pass an inner clp-s archive directory
# to clp-s. clpp archives require --experimental to open, and the binary recognizes a
# self-contained inner archive dir via is_multi_file_archive, so resolving to the
# inner dir (rather than stepping up to the parent) avoids colliding with the
# .yscope-clp-archive.json sidecar the compress wrapper writes next to it.
# A directory holding several archives (one --output-dir shared by several compress
# runs) is searched one archive at a time, below.
mapfile -t archive_dirs < <(list_clp_s_archive_dirs "$archives_dir" || true)
if [[ ${#archive_dirs[@]} -eq 0 ]]; then
  echo "error: could not find a clp-s archive directory under: $input_archives_dir" >&2
  echo "Pass either the top-level plugin archive directory or its inner clp-s archive directory." >&2
  exit 1
fi
# --archive-id picks an archive directory here: clp-s rejects the flag alongside an
# inner archive directory, which is what gets searched.
if [[ -n "$archive_id" ]]; then
  selected=()
  for dir in "${archive_dirs[@]}"; do
    [[ "$(basename -- "$dir")" == "$archive_id" ]] && selected+=("$dir")
  done
  if [[ ${#selected[@]} -eq 0 ]]; then
    echo "error: no archive with ID $archive_id under: $input_archives_dir" >&2
    exit 1
  fi
  archive_dirs=("${selected[@]}")
fi
if [[ ${#archive_dirs[@]} -eq 1 ]]; then
  if [[ "${archive_dirs[0]}" != "$input_archives_dir" ]]; then
    echo "Resolved clp-s archive dir: ${archive_dirs[0]}" >&2
  fi
else
  echo "Searching ${#archive_dirs[@]} archives under: $input_archives_dir" >&2
fi

if [[ "$semantic_active" -eq 1 ]]; then
  # Endpoint precedence: --semantic-endpoint, CLP_SEMANTIC_ENDPOINT, the
  # semantic-endpoint config file, then the built-in remote defaults. The
  # plugin never starts an embedding server itself.
  semantic_endpoint="$(resolve_semantic_endpoint "$semantic_endpoint")" || exit $?
fi

search_options=()

if [[ "$experimental" -eq 1 ]]; then
  search_options+=(--experimental)
fi
if [[ -n "$tge" ]]; then
  search_options+=(--tge "$tge")
fi
if [[ -n "$tle" ]]; then
  search_options+=(--tle "$tle")
fi
if [[ "$ignore_case" -eq 1 ]]; then
  search_options+=(--ignore-case)
fi
if [[ "$count_mode" -eq 1 ]]; then
  search_options+=(--count)
fi
if [[ -n "$unique_field" ]]; then
  search_options+=(--unique "$unique_field")
fi
if [[ "$semantic_active" -eq 1 ]]; then
  search_options+=(--semantic-endpoint "$semantic_endpoint")
fi
if [[ -n "$semantic_top_k" ]]; then
  search_options+=(--semantic-top-k "$semantic_top_k")
fi
if [[ -n "$semantic_threshold" ]]; then
  search_options+=(--semantic-threshold "$semantic_threshold")
fi
if [[ -n "$embedding_batch_size" ]]; then
  search_options+=(--embedding-batch-size "$embedding_batch_size")
fi

if [[ "$semantic_active" -eq 1 ]]; then
  export CLP_SEMANTIC_ENDPOINT="$semantic_endpoint"
  if [[ -z "${CLP_SEMANTIC_BATCH_SIZE:-}" ]]; then
    unset CLP_SEMANTIC_BATCH_SIZE
  fi
  unset CLAUDE_PLUGIN_OPTION_SEMANTIC_ENDPOINT
else
  unset CLP_SEMANTIC_ENDPOINT CLP_SEMANTIC_BATCH_SIZE CLAUDE_PLUGIN_OPTION_SEMANTIC_ENDPOINT
fi

# Search one archive directory. $2, when given, is the --limit for this archive.
search_archive() {
  local dir="$1" dir_limit="${2:-}"
  local dir_projections=("${projections[@]+"${projections[@]}"}")
  local schema_tree resolved_projections

  # clp-s projects leaf columns only: a column inside an array, or an object,
  # projects nothing although a filter on it matches. Rewrite such columns from
  # the archive's schema tree, which clp-s reads from the archive's metadata in
  # milliseconds even on a large archive (lib/projection.py). Without a schema
  # tree the columns stay as given.
  if [[ ${#dir_projections[@]} -gt 0 ]]; then
    if schema_tree="$("$clp_s_bin" s --experimental "$dir" stats.schema_tree 2>/dev/null)" \
        && resolved_projections="$(python3 "${CLP_PLUGIN_BIN_DIR}/lib/projection.py" "${dir_projections[@]}" \
             <<<"$schema_tree")" \
        && [[ -n "$resolved_projections" ]]; then
      mapfile -t dir_projections <<<"$resolved_projections"
    fi
  fi

  local cmd=("$clp_s_bin" s ${search_options[@]+"${search_options[@]}"})
  if [[ -n "$dir_limit" ]]; then
    cmd+=(--limit "$dir_limit")
  fi
  cmd+=("$dir" "$kql_query")
  if [[ ${#dir_projections[@]} -gt 0 ]]; then
    cmd+=(--projection "${dir_projections[@]}")
  fi

  {
    printf 'Command:'
    printf ' %q' "${cmd[@]}"
    echo
  } >&2
  # A record row is wrapped by string concatenation, so the record is passed through
  # byte for byte. Rows that already say which archive they belong to are not wrapped.
  if [[ "$with_archive" -eq 1 && "$count_mode" -eq 0 && -z "$unique_field" && "$trimmed_query" != stats.* ]]; then
    "${cmd[@]}" | awk -v id="$(basename -- "$dir")" '/^\{/ { print "{\"archive_id\":\"" id "\",\"record\":" $0 "}"; next } { print }'
  else
    "${cmd[@]}"
  fi
}

if [[ ${#archive_dirs[@]} -eq 1 ]]; then
  search_archive "${archive_dirs[0]}" "$limit"
  exit $?
fi

# Several archives. clp-s reads a directory of archives itself, but not one that also
# holds the sidecar file, and its --count and --unique rows already carry archive_id,
# so searching each archive and concatenating gives the same rows. --limit is a
# global cap: each archive is asked for what is still needed, and the search stops
# once enough records have come back.
status=0
remaining="$limit"
for dir in "${archive_dirs[@]}"; do
  if [[ -z "$limit" ]]; then
    search_archive "$dir" || status=$?
    continue
  fi
  out="$(mktemp)"
  search_archive "$dir" "$remaining" >"$out" || status=$?
  cat "$out"
  remaining=$(( remaining - $(wc -l <"$out") ))
  rm -f "$out"
  [[ "$remaining" -gt 0 ]] || break
done
exit "$status"
