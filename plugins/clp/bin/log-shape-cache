#!/usr/bin/env python3
"""
log-shape-cache - persistent cache for the log-insights skill's template
classification.

The classification step (grouping the archive's log shapes into
categories and deriving a targeted query plan) is reusable across runs of the
same application: the same app build emits the same message templates, so the
classification is paid once and amortized over every future analysis of that
app. This helper stores and retrieves those classifications, and -- when an
archive GROWS (new logs add new templates) -- drives an incremental update that
classifies only the new templates and merges them into the existing entry,
instead of reclassifying the whole archive.

Cache key (the "app fingerprint") is sha256 of the sorted set of distinct
log shape strings from the archive's dictionary dump
(`clp-s-search-kql ARCHIVE 'stats.log_shapes'`, rendered by `normalize`), each
TRUNCATED to a character limit first (default 500, `--max-chars` /
`$CLP_LOG_SHAPE_MAX_CHARS`) and de-duplicated. Truncation mirrors what
log-shape-cluster sends to the embedding server, so the key identifies the
*embedded* vocabulary. Same embedded vocabulary -> same key -> cache hit ->
classification reused. When it grows, the key changes; `diff` finds the
previous entry whose truncated template set is a subset of the new one (the
archive grew from it) so only the new templates need classifying.

Storage: one SQLite database, <cache-dir>/cache.sqlite. An entry is one row of
`entries` (schema, taxonomy, query_plan, max_chars, classified_at, grown_from)
and one row of `templates` per template. A template is stored by hash, never by
text (see lib/log_shapes.py): `hash` of the full template, `prefix_hash` of its
first max_chars characters, and its `category`. Templates can be hundreds of KB
each -- CockroachDB logs multi-line Pebble stats tables as single messages --
and an entry that held their text grew past 2 GB, which every lookup parsed in
full. The text is in the archive's own dictionary dump; readers join on the
hash. Finding the entry an archive grew from is one indexed subset query.

The same database also stores what each analyzed archive's dictionary holds
(`archives` and `archive_shapes`): per template its hash, its count, its full
length and its first max_chars characters, which is all the fingerprint, the
prefix hashes and a report's truncated templates ever read. An archive is
immutable, so a later analysis of it reads these rows instead of dumping and
rendering the dictionary again. Rows of an archive nobody has analyzed for
ARCHIVE_TTL_DAYS are dropped on the next ingest.

A classification, as read from stdin and printed by `get`, is:
    {
      "app_key": "...",                    # printed by get
      "schema": {"timestamp": "t.$date", "severity": "s", ...},
      "taxonomy": [{"category": "errors", "description": "...",
                    "priority": "high", "why": "..."}],
      "templates": [{"hash": "<sha256>", "prefix_hash": "<sha256>",
                     "category": "errors"}],
      "query_plan": [{"label": "Errors", "method": "count",
                      "match": {"any": [{"field": "s", "eq": "E"},
                                        {"field": "s", "eq": "F"}]},
                      "category": "errors", "priority": "high",
                      "stage": "core"}],
      "max_chars": 500,                    # limit the prefix hashes and key use
      "classified_at": "2026-08-07T...",   # printed by get
      "grown_from": "<previous app_key>"   # present only when incrementally grown
    }
`log-shape-cluster expand` writes this shape. The ranking (taxonomy `priority`
and `why`; each plan entry's `category`, `priority` and `stage`) is described
in lib/classification.py.

Subcommands:
    normalize [--shapes-file F]    Render a `stats.log_shapes` NDJSON dump
                                  (stdin, or F) into canonical log shape NDJSON:
                                  one {"log_shape":"..."} per line, deduplicated.
                                  Detects the shape encoding per line — raw
                                  placeholder bytes (0x11 int / 0x12 str /
                                  0x13 float) from older clp-s builds, or
                                  %placeholder% text (%int%, %rule.name%, ...)
                                  — and renders both as `<*>`. Lines that
                                  already carry a "log_shape" field pass
                                  through unchanged.
    freqs [--shapes-file F]        Sum the per-shape `count`s of a
                                  `stats.log_shapes` dump (stdin, or F) per
                                  canonical log shape, across archives. Prints
                                  {"count":N,"log_shape":"..."} NDJSON, most
                                  frequent first. Exits 1 when any line has a
                                  null count (an archive compressed before
                                  clp-s stored per-log-shape counts).
    freqs --archive-ids A,B        The same counts read from stored archives,
                                  summed per template. Each line also carries
                                  "hash" and the full "length"; "log_shape" is
                                  the stored prefix (the whole template when
                                  length is no longer than it).
    ingest --log-shapes-out F [--shapes-file D]
                                  Render a `stats.log_shapes` dump (stdin, or
                                  D) in one streaming pass: write the log
                                  shapes NDJSON to F (deduplicated, in
                                  dictionary order) and store each archive's
                                  templates. Prints ARCHIVE_IDS=,
                                  LOG_SHAPE_COUNT= and COUNTS=OK|MISSING.
    stored --archive-ids A,B       Exit 0 (printing LOG_SHAPE_COUNT=) when every
                                  archive is stored with counts at --max-chars
                                  or more; exit 1 when it must be ingested.
    key   --log-shapes-file F        Print the app_key for the given log shapes
                                  NDJSON file (accepts raw shape lines too).
    count --log-shapes-file F        Print the number of distinct log shapes in the
                                  log shapes file (the archive's log shape
                                  count).
    diff  --log-shapes-file F        Dynamic-update probe. Prints ONE header line
                                  then NDJSON template lines ({"log_shape":"..."}):
                                    UPTODATE\\t<app_key>\\t<count>
                                        cache is current; no templates to classify.
                                        A template that differs from a cached one
                                        only past the limit takes that one's
                                        category when joined on prefix_hash.
                                    GROWTH\\t<app_key>\\t<base_key>\\t<count>\\t<new_count>
                                        archive grew from <base_key>; the
                                        following <new_count> templates are NEW
                                        and need classifying (then merge).
                                    NEW\\t<app_key>\\t<count>
                                        no base found; all <count> templates
                                        follow and need classifying.
                                  <count> is always the TRUE full template count;
                                  subset matching is done on prefix hashes.
                                  Entries without a valid ranking (stored
                                  before classifications were ranked) are
                                  ignored, with a warning: the app is
                                  classified again and `put` replaces them.
    diff  --archive-ids A,B        The same probe from stored archives, with no
                                  dump. Answers UPTODATE only: when templates
                                  would need classifying, their text is not
                                  stored, so it exits 3 and the caller dumps
                                  the dictionary and runs the file form.
    get   KEY                      Print the cached classification (exit 0); exit
                                  1 on miss.
    merge [--base-key BK]          Read a classification of the NEW templates
                                  from stdin and print it merged with entry BK
                                  (templates by hash, taxonomy by category,
                                  query_plan by label; records grown_from). With
                                  no --base-key it prints the input unchanged.
                                  Writes nothing, so the insight pass can read
                                  the result at once while `put` stores it.
    put   --key K                  Store the classification read from stdin
                                  under K, replacing any entry K. Stamps
                                  `classified_at`. Safe to run in the
                                  background: readers see the old entry or the
                                  new one, never a mix.
    forget [KEY] [--archive-ids A,B]
                                  Delete the classification stored under KEY,
                                  and/or the stored archives A,B. Prints what
                                  it removed; deleting nothing is not an error,
                                  so cleanup steps can run it twice.
    list                           List cached entries: key, template count,
                                  classified_at, grown_from.
    show  KEY                      Pretty-print one cached entry.

merge and put refuse (exit 2, nothing written) a query_plan entry without a
valid "match" filter -- a malformed filter, or a hand-written "kql" string
(see lib/kql_build.py) -- or without its ranking, and a taxonomy entry without
its ranking. merge checks only what it reads from stdin, since a GROWTH
classification may use the base's categories; put checks the whole
classification, including that every plan entry's category is in the taxonomy.

Files of the old one-JSON-file-per-entry cache (<cache-dir>/<KEY>.json) are
ignored, and diff and list say so; they hold no ranking, so delete them.

--cache-dir overrides the default
~/.config/yscope-clp-plugin/log-shape-cache (or $CLP_LOG_SHAPE_CACHE_DIR).
"""
import argparse
import json
import os
import re
import signal
import sqlite3
import sys
import time
from datetime import datetime, timezone

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
from classification import classification_errors, plan_errors, taxonomy_errors  # noqa: E402
from log_shapes import (  # noqa: E402
    DEFAULT_MAX_CHARS, app_key, default_max_chars, prefix_hash, template_hash, truncate_chars)

# Cache keys and template hashes are sha256 hex digests.
_KEY_RE = re.compile(r"\A[0-9a-f]{64}\Z")
DB_NAME = "cache.sqlite"


def resolve_max_chars(value):
    """Resolve a --max-chars value (None -> env/default). Returns 0 on a
    non-positive explicit value, which the caller reports as a usage error."""
    if value is None:
        return default_max_chars()
    return value if value > 0 else 0


def app_key_for_log_shapes(log_shapes, max_chars):
    return app_key(log_shapes, max_chars)


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

# `stats.log_shapes` shape strings come in TWO encodings:
#
# 1. Raw regular-archive log shapes, emitted by clp-s builds that predate
#    per-log-shape counts: variables are placeholder bytes (see
#    clp::ir::VariablePlaceholder) 0x11 integer, 0x12 dictionary/string, 0x13
#    float. A backslash is the escape byte: it is consumed and the byte after
#    it emitted literally (mirroring LogTypeDictionaryEntry::decode_log_type).
# 2. Placeholder text: variables are '%name%' placeholders, a literal '%' is
#    doubled to '%%', and there is NO backslash escaping. clpp
#    (--experimental) archives use '%qualified.rule.name%'; current clp-s
#    renders regular archives the same way, with %int%/%str%/%float%.
#
# The encoding is detected from the placeholder bytes, not from `count`:
# current clp-s emits integer counts for regular archives too, and null for
# regular archives compressed before counts were stored — rendered either way.
_PLACEHOLDER_INT = "\x11"
_PLACEHOLDER_STR = "\x12"
_PLACEHOLDER_FLOAT = "\x13"
_ESCAPE = "\\"


# One pass per encoding in the regex engine: a per-character Python loop took
# 60 s to render a 2.4 GB CockroachDB dictionary, this takes 13 s.
_RAW_TOKEN_RE = re.compile(r"\\(.)|\\\Z|[\x11\x12\x13]", re.S)
_TEXT_TOKEN_RE = re.compile(r"%%|%[^%]*%")


def _render_raw_token(m):
    if m.group(1) is not None:
        return m.group(1)          # an escaped byte, emitted literally
    return "" if m.group() == _ESCAPE else "<*>"


def render_shape(shape):
    """Render a REGULAR-archive shape string (placeholder bytes + backslash
    escapes) into the canonical log shape form used for fingerprinting:
    placeholder bytes become `<*>` and escape bytes are consumed (the escaped
    byte is emitted literally; a trailing escape with nothing to escape is
    dropped, matching decode_log_type's bounds-checked behavior). Applying this
    to an already-rendered log shape string is NOT a no-op (it would eat
    backslashes), so callers must render raw shapes exactly once — and must NOT
    apply it to clpp TextShape strings (use render_text_shape for those)."""
    return _RAW_TOKEN_RE.sub(_render_raw_token, shape)


def render_text_shape(shape):
    """Render a clpp TextShape string into the canonical log shape form:
    '%%' becomes a literal '%', and every '%rule.name%' placeholder becomes
    `<*>`. Backslashes are ordinary characters here (TextShape does not
    escape them). An unpaired trailing '%' is emitted literally."""
    return _TEXT_TOKEN_RE.sub(lambda m: "%" if m.group() == "%%" else "<*>", shape)


def shape_line_to_log_shape(obj):
    """Return the canonical log shape string for one parsed NDJSON line, or None.

    Lines carrying a "log_shape" field are already canonical and pass through
    unchanged. Lines carrying a "shape" field are rendered according to its
    encoding: raw placeholder bytes when any are present, placeholder text
    otherwise (see the encoding notes above)."""
    if not isinstance(obj, dict):
        return None
    lt = obj.get("log_shape")
    if isinstance(lt, str):
        return lt
    shape = obj.get("shape")
    if not isinstance(shape, str):
        return None
    if any(p in shape for p in (_PLACEHOLDER_INT, _PLACEHOLDER_STR, _PLACEHOLDER_FLOAT)):
        return render_shape(shape)
    return render_text_shape(shape)

# Let `head`/pagers close our stdout without raising BrokenPipeError.
if hasattr(signal, "SIGPIPE"):
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (ValueError, OSError):
        pass


def default_cache_dir():
    env = os.environ.get("CLP_LOG_SHAPE_CACHE_DIR")
    if env:
        return os.path.expanduser(env)
    return os.path.expanduser("~/.config/yscope-clp-plugin/log-shape-cache")


# --- Storage -----------------------------------------------------------------

SCHEMA_SQL = """
CREATE TABLE IF NOT EXISTS entries (
    app_key          TEXT PRIMARY KEY,
    max_chars        INTEGER NOT NULL,
    schema           TEXT,              -- JSON object, or NULL
    taxonomy         TEXT NOT NULL,     -- JSON array
    query_plan       TEXT NOT NULL,     -- JSON array
    classified_at    TEXT NOT NULL,
    plan_updated_at  TEXT,
    grown_from       TEXT
);
CREATE TABLE IF NOT EXISTS templates (
    app_key      TEXT NOT NULL REFERENCES entries(app_key) ON DELETE CASCADE,
    hash         TEXT NOT NULL,         -- sha256 of the full template
    prefix_hash  TEXT NOT NULL,         -- sha256 of its first max_chars characters
    category     TEXT NOT NULL,
    PRIMARY KEY (app_key, hash)
) WITHOUT ROWID;
CREATE INDEX IF NOT EXISTS templates_by_prefix ON templates(app_key, prefix_hash);
CREATE TABLE IF NOT EXISTS archives (
    archive_id   TEXT PRIMARY KEY,      -- the clp-s archive's id (its directory name)
    max_chars    INTEGER NOT NULL,      -- length the stored prefixes were cut to
    has_counts   INTEGER NOT NULL,      -- 0: compressed before clp-s stored per-shape counts
    ingested_at  TEXT NOT NULL,
    used_at      TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS archive_shapes (
    archive_id   TEXT NOT NULL REFERENCES archives(archive_id) ON DELETE CASCADE,
    hash         TEXT NOT NULL,         -- sha256 of the full template
    prefix       TEXT NOT NULL,         -- its first max_chars characters
    length       INTEGER NOT NULL,      -- its full length, in characters
    count        INTEGER,               -- records carrying it; NULL when has_counts = 0
    PRIMARY KEY (archive_id, hash)
);
"""

# Stored archives nobody has analyzed for this long are dropped on the next
# ingest; an archive is immutable, so the rows never go stale, only unused.
ARCHIVE_TTL_DAYS = 30


def check_key(key):
    if not isinstance(key, str) or not _KEY_RE.match(key):
        raise SystemExit(f"error: invalid cache key {key!r}: expected a 64-character hex digest")
    return key


def connect(cache_dir):
    os.makedirs(cache_dir, exist_ok=True)
    db = sqlite3.connect(os.path.join(cache_dir, DB_NAME), timeout=120)
    # WAL lets a background `put` write while `diff`/`get` read.
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA foreign_keys=ON")
    db.executescript(SCHEMA_SQL)
    return db


def legacy_files(cache_dir):
    """Entries of the old one-JSON-file-per-entry cache still in cache_dir."""
    if not os.path.isdir(cache_dir):
        return []
    return sorted(n for n in os.listdir(cache_dir) if n.endswith(".json") and _KEY_RE.match(n[:-5]))


def warn_legacy(cache_dir):
    old = legacy_files(cache_dir)
    if old:
        print(f"warning: {len(old)} cache entr{'y is' if len(old) == 1 else 'ies are'} in the old JSON "
              f"format and ignored; delete {'it' if len(old) == 1 else 'them'} from {cache_dir}",
              file=sys.stderr)


def load_entry(db, key):
    row = db.execute(
        "SELECT max_chars, schema, taxonomy, query_plan, classified_at, plan_updated_at, grown_from "
        "FROM entries WHERE app_key = ?", (key,)).fetchone()
    if row is None:
        return None
    obj = {"app_key": key, "max_chars": row[0]}
    if row[1] is not None:
        obj["schema"] = json.loads(row[1])
    obj["taxonomy"] = json.loads(row[2])
    obj["query_plan"] = json.loads(row[3])
    obj["classified_at"] = row[4]
    if row[5]:
        obj["plan_updated_at"] = row[5]
    if row[6]:
        obj["grown_from"] = row[6]
    obj["templates"] = [
        {"hash": h, "prefix_hash": p, "category": c}
        for h, p, c in db.execute(
            "SELECT hash, prefix_hash, category FROM templates WHERE app_key = ? ORDER BY hash", (key,))
    ]
    return obj


def store_entry(db, key, obj, max_chars, classified_at=None):
    """Replace entry `key` with `obj` in one transaction."""
    templates = {t["hash"]: t for t in obj["templates"]}  # the last one for a hash wins
    with db:
        db.execute("DELETE FROM entries WHERE app_key = ?", (key,))
        db.execute(
            "INSERT INTO entries (app_key, max_chars, schema, taxonomy, query_plan, classified_at, "
            "plan_updated_at, grown_from) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
            (key, max_chars,
             json.dumps(obj["schema"], ensure_ascii=False) if "schema" in obj else None,
             json.dumps(obj.get("taxonomy", []), ensure_ascii=False),
             json.dumps(obj.get("query_plan", []), ensure_ascii=False),
             classified_at or now(), obj.get("plan_updated_at"), obj.get("grown_from")))
        db.executemany(
            "INSERT INTO templates (app_key, hash, prefix_hash, category) VALUES (?, ?, ?, ?)",
            ((key, t["hash"], t["prefix_hash"], t["category"]) for t in templates.values()))
    return len(templates)


def read_classification(stream):
    """The classification JSON from stream, validated, or (None, rc)."""
    try:
        obj = json.loads(stream.read())
    except json.JSONDecodeError as e:
        print(f"error: stdin is not valid JSON: {e}", file=sys.stderr)
        return None, 2
    if not isinstance(obj, dict):
        print("error: classification JSON must be a JSON object", file=sys.stderr)
        return None, 2
    for field in ("templates", "taxonomy", "query_plan"):
        if field in obj and not isinstance(obj[field], list):
            print(f"error: '{field}' must be a JSON array", file=sys.stderr)
            return None, 2
    obj.setdefault("templates", [])
    for i, t in enumerate(obj["templates"], 1):
        if not isinstance(t, dict):
            print(f"error: templates[{i}] is not an object", file=sys.stderr)
            return None, 2
        if "log_shape" in t:
            print(f"error: templates[{i}] carries template text ('log_shape'); the cache stores "
                  f"templates by hash -- produce the classification with `log-shape-cluster expand`",
                  file=sys.stderr)
            return None, 2
        if not (isinstance(t.get("hash"), str) and _KEY_RE.match(t["hash"])
                and isinstance(t.get("prefix_hash"), str) and _KEY_RE.match(t["prefix_hash"])
                and isinstance(t.get("category"), str)):
            print(f"error: templates[{i}] needs 'hash' and 'prefix_hash' (sha256 hex) and a "
                  f"'category' string", file=sys.stderr)
            return None, 2
    # A GROWTH classification may use the base's categories, so membership is
    # checked by put, on the merged whole.
    if refuse(taxonomy_errors(obj.get("taxonomy", [])) + plan_errors(obj.get("query_plan", []))):
        return None, 2
    return obj, 0

def load_log_shapes(path):
    """Return the set of distinct canonical log shape strings from a dictionary
    NDJSON file. Accepts both line shapes:
      {"log_shape": "..."}                      already canonical (`<*>` markers)
      {...,"count":...,"shape": "..."}        raw stats.log_shapes line; the
                                              shape is rendered per its
                                              encoding (see shape_line_to_log_shape)
    A line carrying both fields uses "log_shape" (assumed already rendered).
    Returns an empty set if the file has no parseable lines."""
    log_shapes = set()
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or not line.startswith("{"):
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            lt = shape_line_to_log_shape(obj)
            if isinstance(lt, str) and lt.strip():
                log_shapes.add(lt)
    return log_shapes

class InputError(Exception):
    """A shapes dump that cannot be read; the message says why."""


def iter_shape_objects(shapes_file):
    """The JSON objects of a stats.log_shapes dump (shapes_file, or stdin when
    None), one at a time, skipping non-JSON lines. A dictionary can be
    gigabytes, so nothing here holds more than one line. Raises InputError."""
    if shapes_file:
        if not os.path.isfile(shapes_file):
            raise InputError(f"shapes file not found: {shapes_file}")
        try:
            src = open(shapes_file, "r", encoding="utf-8")
        except OSError as e:
            raise InputError(f"cannot read shapes file: {e}") from e
    else:
        src = sys.stdin
    try:
        for line in src:
            if not line.startswith("{"):
                line = line.strip()
                if not line.startswith("{"):
                    continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue
    except UnicodeDecodeError as e:
        raise InputError(f"shapes file is not valid UTF-8: {e}") from e
    finally:
        if src is not sys.stdin:
            src.close()


def iter_rendered(shapes_file):
    """(object, log_shape) per dictionary line that renders to a template."""
    for obj in iter_shape_objects(shapes_file):
        lt = shape_line_to_log_shape(obj)
        if isinstance(lt, str) and lt.strip():
            yield obj, lt


def valid_count(obj):
    count = obj.get("count")
    return count if isinstance(count, int) and not isinstance(count, bool) else None


NO_COUNTS_HINT = ("the archive was compressed by a clp-s build that does not store "
                  "per-log-shape counts. Recompress it with the current plugin.")


def cmd_normalize(args):
    """Render stats.log_shapes NDJSON (stdin or --shapes-file) to canonical
    {"log_shape": "..."} NDJSON, deduplicated and sorted."""
    try:
        log_shapes = {lt for _, lt in iter_rendered(args.shapes_file)}
    except InputError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    if not log_shapes:
        print("error: no log shape entries found in input", file=sys.stderr)
        return 1
    for lt in sorted(log_shapes):
        print(json.dumps({"log_shape": lt}, ensure_ascii=False))
    return 0


def cmd_freqs(args):
    """Per-template counts, most frequent first, as {"count":N,"log_shape":"..."}
    NDJSON. From a stats.log_shapes dump (stdin or --shapes-file): summed per
    canonical log shape across archives (archives number their shapes
    independently, so the sum is keyed by the rendered log shape, never by
    `id`). From stored archives (--archive-ids): summed per template hash, and
    each line also carries the template's "hash" and full "length"; its
    "log_shape" is the stored prefix, which is the whole template when length
    is no more than the prefix's."""
    if args.archive_ids:
        return freqs_from_store(args)
    counts = {}
    missing = 0
    try:
        for obj, lt in iter_rendered(args.shapes_file):
            count = valid_count(obj)
            if count is None:
                missing += 1
                continue
            counts[lt] = counts.get(lt, 0) + count
    except InputError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    if missing:
        print(f"error: {missing} stats.log_shapes line(s) have no count; {NO_COUNTS_HINT}", file=sys.stderr)
        return 1
    if not counts:
        print("error: no log shape entries found in input", file=sys.stderr)
        return 1
    for lt, count in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])):
        print(json.dumps({"count": count, "log_shape": lt}, ensure_ascii=False))
    return 0


# --- Stored archives ---------------------------------------------------------
#
# An archive is immutable, so what its dictionary says never changes: `ingest`
# renders a dump once and stores, per archive, each template's hash, count,
# length and first max_chars characters -- never the full text, which can be
# megabytes per template. A later analysis of the same archive reads the counts
# back (`freqs --archive-ids`) and probes the classification cache from the
# stored prefixes (`diff --archive-ids`) without dumping the dictionary again.


def parse_ids(text):
    ids = [i for i in (text or "").split(",") if i]
    if not ids:
        raise SystemExit("error: --archive-ids needs at least one archive id")
    return ids


def stored_archives(db, ids, max_chars):
    """True when every archive in ids is stored, with counts, at max_chars or
    more (a prefix can be cut shorter, never longer)."""
    rows = db.execute(
        f"SELECT COUNT(*) FROM archives WHERE archive_id IN ({','.join('?' * len(ids))}) "
        "AND has_counts = 1 AND max_chars >= ?", (*ids, max_chars)).fetchone()
    return rows[0] == len(set(ids))


def stored_shapes(db, ids):
    """{hash: (prefix, length, count)} over the given archives, counts summed."""
    shapes = {}
    for h, prefix, length, count in db.execute(
            f"SELECT hash, prefix, length, count FROM archive_shapes "
            f"WHERE archive_id IN ({','.join('?' * len(ids))})", ids):
        old = shapes.get(h)
        shapes[h] = (prefix, length, (old[2] if old else 0) + (count or 0))
    return shapes


def touch_archives(db, ids):
    with db:
        db.execute(f"UPDATE archives SET used_at = ? WHERE archive_id IN ({','.join('?' * len(ids))})",
                   (now(), *ids))


def cmd_ingest(args):
    """Render a stats.log_shapes dump once: write the canonical log shapes file
    and store each archive's templates (hash, count, length, prefix)."""
    max_chars = resolve_max_chars(args.max_chars)
    if max_chars == 0:
        print("error: --max-chars must be a positive integer", file=sys.stderr)
        return 2
    per_archive = {}   # archive_id -> {hash: [prefix, length, count or None]}
    no_counts = set()
    seen = set()
    try:
        with open(args.log_shapes_out, "w", encoding="utf-8") as out:
            for obj, lt in iter_rendered(args.shapes_file):
                aid = obj.get("archive_id")
                if not isinstance(aid, str) or not aid:
                    print("error: a stats.log_shapes line has no archive_id", file=sys.stderr)
                    return 1
                h = template_hash(lt)
                count = valid_count(obj)
                if count is None:
                    no_counts.add(aid)
                shapes = per_archive.setdefault(aid, {})
                row = shapes.get(h)
                if row is None:
                    shapes[h] = [truncate_chars(lt, max_chars), len(lt), count]
                elif count is not None and row[2] is not None:
                    row[2] += count
                if h not in seen:
                    seen.add(h)
                    out.write(json.dumps({"log_shape": lt}, ensure_ascii=False) + "\n")
    except InputError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    if not seen:
        print("error: no log shape entries found in input", file=sys.stderr)
        return 1

    stamp = now()
    cutoff = datetime.fromtimestamp(time.time() - ARCHIVE_TTL_DAYS * 86400, timezone.utc) \
        .strftime("%Y-%m-%dT%H:%M:%SZ")
    db = connect(args.cache_dir)
    with db:
        db.execute("DELETE FROM archives WHERE used_at < ?", (cutoff,))
        # The cascade only runs on connections with foreign keys on, so rows
        # another client left behind are removed by hand.
        db.execute("DELETE FROM archive_shapes WHERE archive_id NOT IN (SELECT archive_id FROM archives)")
        for aid, shapes in per_archive.items():
            db.execute("DELETE FROM archives WHERE archive_id = ?", (aid,))
            db.execute("DELETE FROM archive_shapes WHERE archive_id = ?", (aid,))
            db.execute("INSERT INTO archives (archive_id, max_chars, has_counts, ingested_at, used_at) "
                       "VALUES (?, ?, ?, ?, ?)", (aid, max_chars, int(aid not in no_counts), stamp, stamp))
            db.executemany(
                "INSERT INTO archive_shapes (archive_id, hash, prefix, length, count) VALUES (?, ?, ?, ?, ?)",
                ((aid, h, p, n, None if aid in no_counts else c) for h, (p, n, c) in shapes.items()))
    print(f"ARCHIVE_IDS={','.join(sorted(per_archive))}")
    print(f"LOG_SHAPE_COUNT={len(seen)}")
    print(f"COUNTS={'MISSING' if no_counts else 'OK'}")
    return 0


def cmd_stored(args):
    """Exit 0 when every archive is stored with counts at max_chars or more
    (and mark them used), 1 otherwise."""
    ids = parse_ids(args.archive_ids)
    max_chars = resolve_max_chars(args.max_chars)
    db = connect(args.cache_dir)
    if not stored_archives(db, ids, max_chars):
        return 1
    touch_archives(db, ids)
    print(f"LOG_SHAPE_COUNT={len(stored_shapes(db, ids))}")
    return 0


def freqs_from_store(args):
    ids = parse_ids(args.archive_ids)
    db = connect(args.cache_dir)
    if not stored_archives(db, ids, 1):
        print(f"error: not every archive in --archive-ids is stored with counts; {NO_COUNTS_HINT} "
              f"Or run `log-shape-cache ingest` on its stats.log_shapes dump first.", file=sys.stderr)
        return 1
    rows = stored_shapes(db, ids)
    for h, (prefix, length, count) in sorted(rows.items(), key=lambda kv: (-kv[1][2], kv[1][0])):
        print(json.dumps({"count": count, "hash": h, "length": length, "log_shape": prefix},
                         ensure_ascii=False))
    return 0


def cmd_key(args):
    if not os.path.exists(args.log_shapes_file):
        print(f"error: log shapes file not found: {args.log_shapes_file}", file=sys.stderr)
        return 2
    log_shapes = load_log_shapes(args.log_shapes_file)
    if not log_shapes:
        print("error: no log shape entries found in file", file=sys.stderr)
        return 1
    max_chars = resolve_max_chars(args.max_chars)
    if max_chars == 0:
        print("error: --max-chars must be a positive integer", file=sys.stderr)
        return 2
    print(app_key_for_log_shapes(log_shapes, max_chars))
    return 0


def cmd_count(args):
    if not os.path.exists(args.log_shapes_file):
        print(f"error: log shapes file not found: {args.log_shapes_file}", file=sys.stderr)
        return 2
    log_shapes = load_log_shapes(args.log_shapes_file)
    print(len(log_shapes))
    return 0

def refuse(errors):
    for line in errors:
        print(f"error: {line}", file=sys.stderr)
    if errors:
        print("error: nothing written; fix the classification above "
              "(check with kql-build check-plan)", file=sys.stderr)
    return bool(errors)


def unranked_keys(db):
    """Keys of the entries stored without a valid ranking. They are never
    reused: the app is classified again and put replaces the entry."""
    stale = set()
    for key, taxonomy, plan in db.execute("SELECT app_key, taxonomy, query_plan FROM entries"):
        try:
            obj = {"taxonomy": json.loads(taxonomy), "query_plan": json.loads(plan)}
        except json.JSONDecodeError:
            stale.add(key)
            continue
        if classification_errors(obj):
            stale.add(key)
    return stale


class NeedsText(Exception):
    """The stored prefixes cannot answer; the full templates are needed."""


def find_base(db, log_shapes, skip=frozenset(), text_limit=None):
    """(exact_key, best_key): an entry whose prefix-hash set equals the
    archive's, and the entry whose set is the largest PROPER subset of it (the
    archive grew from it), each or None, never one in `skip`. Each entry is
    compared at the limit it was stored with. Requiring a proper subset means a
    GROWTH report always has new templates. With text_limit, log_shapes are
    prefixes cut at that many characters, and an entry stored at a longer limit
    raises NeedsText."""
    exact, best, best_n = None, None, -1
    db.execute("CREATE TEMP TABLE IF NOT EXISTS probe (h TEXT PRIMARY KEY)")
    for (limit,) in db.execute("SELECT DISTINCT max_chars FROM entries").fetchall():
        if text_limit is not None and limit > text_limit:
            raise NeedsText(f"a cached classification uses a {limit}-character limit")
        probe = {prefix_hash(lt, limit) for lt in log_shapes}
        db.execute("DELETE FROM probe")
        db.executemany("INSERT INTO probe (h) VALUES (?)", ((h,) for h in probe))
        rows = db.execute(
            "SELECT t.app_key, COUNT(DISTINCT t.prefix_hash), COUNT(DISTINCT p.h) "
            "FROM templates t JOIN entries e ON e.app_key = t.app_key AND e.max_chars = ? "
            "LEFT JOIN probe p ON p.h = t.prefix_hash GROUP BY t.app_key", (limit,)).fetchall()
        for key, n, hits in sorted(rows):
            if key in skip or n != hits:
                continue  # holds a template this archive doesn't have
            if n == len(probe):
                exact = exact or key
            elif n > best_n:
                best, best_n = key, n
    return exact, best


def cmd_diff(args):
    max_chars = resolve_max_chars(args.max_chars)
    if max_chars == 0:
        print("error: --max-chars must be a positive integer", file=sys.stderr)
        return 2
    if bool(args.log_shapes_file) == bool(args.archive_ids):
        print("error: give exactly one of --log-shapes-file and --archive-ids", file=sys.stderr)
        return 2
    warn_legacy(args.cache_dir)
    db = connect(args.cache_dir)
    text_limit = None
    if args.archive_ids:
        # The stored prefixes stand in for the templates: the fingerprint and
        # the prefix hashes only read the first max_chars characters, and the
        # full hash is stored. Only the text of NEW or GROWTH templates, which
        # would have to be classified, is missing.
        ids = parse_ids(args.archive_ids)
        if not stored_archives(db, ids, max_chars):
            print("error: not every archive in --archive-ids is stored at this --max-chars; "
                  "run `log-shape-cache ingest` first", file=sys.stderr)
            return 1
        text_limit = db.execute(
            f"SELECT MIN(max_chars) FROM archives WHERE archive_id IN ({','.join('?' * len(ids))})",
            ids).fetchone()[0]
        by_hash = {h: prefix for h, (prefix, _, _) in stored_shapes(db, ids).items()}
    else:
        if not os.path.exists(args.log_shapes_file):
            print(f"error: log shapes file not found: {args.log_shapes_file}", file=sys.stderr)
            return 2
        by_hash = {template_hash(lt): lt for lt in load_log_shapes(args.log_shapes_file)}
    if not by_hash:
        print("error: no log shape entries found", file=sys.stderr)
        return 1
    log_shapes = by_hash.values()
    key = app_key_for_log_shapes(log_shapes, max_chars)
    stale = unranked_keys(db)
    if stale:
        print(f"warning: {len(stale)} cache entr{'y predates' if len(stale) == 1 else 'ies predate'} "
              f"ranked classifications and {'is' if len(stale) == 1 else 'are'} ignored; the app is "
              f"classified again and the entry replaced", file=sys.stderr)

    if key not in stale and db.execute("SELECT 1 FROM entries WHERE app_key = ?", (key,)).fetchone():
        print(f"UPTODATE\t{key}\t{len(by_hash)}")
        return 0
    try:
        exact, best = find_base(db, log_shapes, stale, text_limit)
        if exact:
            # Same vocabulary stored under another key (another character limit).
            print(f"UPTODATE\t{exact}\t{len(by_hash)}")
            return 0
        if text_limit is not None:
            raise NeedsText("templates need classifying")
    except NeedsText as e:
        print(f"note: {e}; the stored prefixes cannot say which. Dump the dictionary and run "
              f"`diff --log-shapes-file` instead.", file=sys.stderr)
        return 3
    if best:
        base = {h for (h,) in db.execute("SELECT hash FROM templates WHERE app_key = ?", (best,))}
        new = sorted(lt for h, lt in by_hash.items() if h not in base)
        if new:
            print(f"GROWTH\t{key}\t{best}\t{len(by_hash)}\t{len(new)}")
            for lt in new:
                print(json.dumps({"log_shape": lt}, ensure_ascii=False))
            return 0
        # find_base only returns proper subsets, so this is unreachable; never
        # emit a GROWTH that has nothing to classify.
        print(f"UPTODATE\t{best}\t{len(by_hash)}")
        return 0

    # No base: first classification of this application.
    print(f"NEW\t{key}\t{len(by_hash)}")
    for lt in sorted(log_shapes):
        print(json.dumps({"log_shape": lt}, ensure_ascii=False))
    return 0


def cmd_get(args):
    obj = load_entry(connect(args.cache_dir), check_key(args.key))
    if obj is None:
        return 1
    sys.stdout.write(json.dumps(obj, ensure_ascii=False))
    sys.stdout.write("\n")
    return 0


def cmd_merge(args):
    new, rc = read_classification(sys.stdin)
    if new is None:
        return rc
    if args.base_key:
        base = load_entry(connect(args.cache_dir), check_key(args.base_key))
        if base is None:
            print(f"warning: base key not found: {args.base_key}; using the new classification alone",
                  file=sys.stderr)
        else:
            # Templates by hash (base first, new overrides/extends).
            merged = {t["hash"]: t for t in base["templates"]}
            merged.update({t["hash"]: t for t in new["templates"]})
            new["templates"] = list(merged.values())
            # Taxonomy by category (base first, new categories appended).
            cats = {}
            for c in base["taxonomy"] + new.get("taxonomy", []):
                if isinstance(c, dict) and c.get("category") is not None:
                    cats.setdefault(c["category"], c)
            new["taxonomy"] = list(cats.values())
            # Query plan by label (base first; new-only labels appended).
            labels = {}
            for q in base["query_plan"] + new.get("query_plan", []):
                if isinstance(q, dict) and q.get("label") is not None:
                    labels.setdefault(q["label"], q)
            new["query_plan"] = list(labels.values())
            # Keep the base schema if the new classification didn't restate it.
            if "schema" not in new and "schema" in base:
                new["schema"] = base["schema"]
            new.setdefault("max_chars", base["max_chars"])
            new["grown_from"] = args.base_key
    sys.stdout.write(json.dumps(new, ensure_ascii=False))
    sys.stdout.write("\n")
    return 0


def cmd_put(args):
    obj, rc = read_classification(sys.stdin)
    if obj is None:
        return rc
    if refuse(classification_errors(obj)):
        return 2
    max_chars = args.max_chars if args.max_chars is not None else obj.get("max_chars", default_max_chars())
    if not isinstance(max_chars, int) or max_chars < 1:
        print("error: --max-chars must be a positive integer", file=sys.stderr)
        return 2
    started = time.monotonic()
    n = store_entry(connect(args.cache_dir), check_key(args.key), obj, max_chars)
    print(f"Stored classification for app_key {args.key}: {n} templates in "
          f"{time.monotonic() - started:.1f}s -> {os.path.join(args.cache_dir, DB_NAME)}", file=sys.stderr)
    return 0


def cmd_forget(args):
    if not args.key and not args.archive_ids:
        print("error: give a KEY, --archive-ids, or both", file=sys.stderr)
        return 2
    db = connect(args.cache_dir)
    with db:
        if args.key:
            key = check_key(args.key)
            # By hand as well as by cascade: see cmd_ingest.
            db.execute("DELETE FROM templates WHERE app_key = ?", (key,))
            n = db.execute("DELETE FROM entries WHERE app_key = ?", (key,)).rowcount
            print(f"Forgot {n} classification{'' if n == 1 else 's'} ({key})", file=sys.stderr)
        if args.archive_ids:
            ids = parse_ids(args.archive_ids)
            marks = ",".join("?" * len(ids))
            db.execute(f"DELETE FROM archive_shapes WHERE archive_id IN ({marks})", ids)
            n = db.execute(f"DELETE FROM archives WHERE archive_id IN ({marks})", ids).rowcount
            print(f"Forgot {n} stored archive{'' if n == 1 else 's'}", file=sys.stderr)
    return 0


def cmd_list(args):
    warn_legacy(args.cache_dir)
    rows = connect(args.cache_dir).execute(
        "SELECT e.app_key, COUNT(t.hash), e.classified_at, e.grown_from FROM entries e "
        "LEFT JOIN templates t ON t.app_key = e.app_key GROUP BY e.app_key ORDER BY e.app_key").fetchall()
    if not rows:
        print(f"(no cached classifications in {args.cache_dir})", file=sys.stderr)
        return 0
    print(f"{'app_key':<66}  templates  classified_at          grown_from")
    for key, n, ts, gf in rows:
        print(f"{key:<66}  {n:>9}  {ts:<20}  {gf[:12] if gf else '-'}")
    return 0


def cmd_show(args):
    obj = load_entry(connect(args.cache_dir), check_key(args.key))
    if obj is None:
        print(f"error: no cache entry for key {args.key}", file=sys.stderr)
        return 1
    print(json.dumps(obj, indent=2, ensure_ascii=False))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="log-shape-cache",
        description="Persistent classification cache for the log-insights skill, "
                    "with incremental update on archive growth.",
    )
    sub = p.add_subparsers(dest="command", required=True)

    pn = sub.add_parser("normalize", help="Render stats.log_shapes NDJSON to canonical log shape NDJSON.")
    pn.add_argument("--shapes-file", default=None, help="Input file (default: stdin).")
    pn.set_defaults(func=cmd_normalize)

    pf = sub.add_parser("freqs", help="Per-template counts, from a dump or from stored archives.")
    pf.add_argument("--shapes-file", default=None, help="Input file (default: stdin).")
    pf.add_argument("--archive-ids", default=None,
                    help="Comma-separated archive ids to read from the store instead of a dump.")
    pf.set_defaults(func=cmd_freqs)

    pi = sub.add_parser("ingest", help="Render a stats.log_shapes dump once; store its archives.")
    pi.add_argument("--shapes-file", default=None, help="Input file (default: stdin).")
    pi.add_argument("--log-shapes-out", required=True, help="Where to write the log shapes NDJSON.")
    pi.set_defaults(func=cmd_ingest)

    pst = sub.add_parser("stored", help="Exit 0 when every archive is stored with counts.")
    pst.add_argument("--archive-ids", required=True, help="Comma-separated archive ids.")
    pst.set_defaults(func=cmd_stored)

    pk = sub.add_parser("key", help="Compute the app_key for a log shapes NDJSON file.")
    pk.add_argument("--log-shapes-file", required=True)
    pk.set_defaults(func=cmd_key)

    pc = sub.add_parser("count", help="Print the number of distinct log shapes in the log shapes file.")
    pc.add_argument("--log-shapes-file", required=True)
    pc.set_defaults(func=cmd_count)

    pd = sub.add_parser("diff", help="Probe for cache hit/growth/new; emit templates to classify.")
    pd.add_argument("--log-shapes-file", default=None)
    pd.add_argument("--archive-ids", default=None,
                    help="Comma-separated stored archive ids to probe with instead of a log shapes file.")
    pd.set_defaults(func=cmd_diff)

    pg = sub.add_parser("get", help="Print a cached classification (exit 1 on miss).")
    pg.add_argument("key")
    pg.set_defaults(func=cmd_get)

    pm = sub.add_parser("merge", help="Merge a new-template classification into a base entry; print it.")
    pm.add_argument("--base-key", default=None, help="Base app_key to merge into (absent = print as is).")
    pm.set_defaults(func=cmd_merge)

    pp = sub.add_parser("put", help="Store a classification read from stdin.")
    pp.add_argument("--key", required=True, help="app_key to store it under.")
    pp.set_defaults(func=cmd_put)

    pfg = sub.add_parser("forget", help="Delete a classification and/or stored archives.")
    pfg.add_argument("key", nargs="?", default=None, help="app_key of the classification to delete.")
    pfg.add_argument("--archive-ids", default=None, help="Comma-separated stored archive ids to delete.")
    pfg.set_defaults(func=cmd_forget)

    pl = sub.add_parser("list", help="List cached classifications.")
    pl.set_defaults(func=cmd_list)

    ps = sub.add_parser("show", help="Pretty-print one cached classification.")
    ps.add_argument("key")
    ps.set_defaults(func=cmd_show)

    for subp in (pf, pi, pst, pd, pg, pm, pp, pfg, pl, ps):
        subp.add_argument(
            "--cache-dir",
            default=default_cache_dir(),
            help="Cache directory (default: %(default)s, or $CLP_LOG_SHAPE_CACHE_DIR).",
        )

    # --max-chars for the subcommands that compute or stamp the fingerprint.
    for subp in (pk, pi, pst, pd, pp):
        subp.add_argument(
            "--max-chars",
            type=int,
            default=None,
            help=f"cap each template at this many characters before fingerprinting "
                 f"(default: {DEFAULT_MAX_CHARS}, or $CLP_LOG_SHAPE_MAX_CHARS)",
        )

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
