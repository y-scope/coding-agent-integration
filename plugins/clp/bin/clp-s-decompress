#!/usr/bin/env bash
set -euo pipefail

CLP_PLUGIN_BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1091
source "${CLP_PLUGIN_BIN_DIR}/lib/clp-common.sh"

usage() {
  cat <<'EOF'
Usage:
  clp-s-decompress [options] ARCHIVES_DIR OUTPUT_DIR

Decompress a regular clp-s archive directory into OUTPUT_DIR.

Allowed controls:
  --archive-id ID                    Limit decompression to one archive ID.
  --ordered                          Decompress records in log order.
  --target-ordered-chunk-size SIZE   Chunk ordered output files by size.
  --print-ordered-chunk-stats        Print ordered chunk statistics.
  --dry-run                          Print the planned decompression only.
  --experimental                     Force clp-s experimental (clpp) mode. clpp
                                     archives require it; auto-detected by default.
  --no-experimental                  Force stable mode even for a clpp archive.
  --clp-s-bin PATH                   Use this clp-s binary for this invocation only.
                                     Overrides the CLP_S_BIN env var and the installed
                                     plugin binary; useful for pointing at a local build.
  -h, --help                         Show this help.

clpp (clp+ / --experimental) archives are decompressed the same way as stable
archives: the wrapper auto-detects them (by the presence of a parsing_specification
or parent_rule_shapes file in the archive) and passes --experimental for you.

This wrapper intentionally does not expose network/S3 auth, MongoDB metadata
output, or arbitrary clp-s option passthrough.
EOF
}

archive_id=""
ordered=0
target_ordered_chunk_size=""
print_ordered_chunk_stats=0
dry_run=0
# experimental: 1 = force on, 0 = auto (detect clpp archives), -1 = force off
experimental=0
experimental_auto=1
clp_s_bin_override=""
archives_dir=""
output_dir=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --archive-id)
      [[ $# -ge 2 ]] || { echo "error: --archive-id requires a value" >&2; exit 2; }
      archive_id="$2"
      shift 2
      ;;
    --ordered)
      ordered=1
      shift
      ;;
    --target-ordered-chunk-size)
      [[ $# -ge 2 ]] || { echo "error: --target-ordered-chunk-size requires a value" >&2; exit 2; }
      target_ordered_chunk_size="$2"
      shift 2
      ;;
    --print-ordered-chunk-stats)
      print_ordered_chunk_stats=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --experimental)
      experimental=1
      experimental_auto=0
      shift
      ;;
    --no-experimental)
      experimental=-1
      experimental_auto=0
      shift
      ;;
    --clp-s-bin)
      [[ $# -ge 2 ]] || { echo "error: --clp-s-bin requires a value" >&2; exit 2; }
      clp_s_bin_override="$2"
      shift 2
      ;;
    --auth|--mongodb-uri|--mongodb-collection)
      echo "error: unsupported decompression option: $1" >&2
      exit 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      echo "error: arbitrary clp-s option passthrough is not exposed by this wrapper" >&2
      exit 2
      ;;
    -*)
      echo "error: unsupported option: $1" >&2
      echo >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -z "$archives_dir" ]]; then
        archives_dir="$1"
      elif [[ -z "$output_dir" ]]; then
        output_dir="$1"
      else
        echo "error: unexpected positional argument: $1" >&2
        exit 2
      fi
      shift
      ;;
  esac
done

if [[ -z "$archives_dir" || -z "$output_dir" ]]; then
  usage >&2
  exit 2
fi

if [[ ! -d "$archives_dir" ]]; then
  echo "error: archives directory does not exist: $archives_dir" >&2
  exit 1
fi
print_archive_metadata_summary "$archives_dir"
input_archives_dir="$archives_dir"
archives_dir="$(resolve_clp_s_archive_dir "$archives_dir")" || {
  echo "error: could not find a clp-s archive directory under: $input_archives_dir" >&2
  echo "Pass either the top-level plugin archive directory or its inner clp-s archive directory." >&2
  exit 1
}

# Auto-detect clpp (experimental) archives by their clpp-only marker files and
# enable --experimental unless the caller forced stable mode (--no-experimental).
# clpp archives require --experimental to decompress.
if [[ "$experimental_auto" -eq 1 ]]; then
  if [[ -f "$archives_dir/parsing_specification" || -f "$archives_dir/parent_rule_shapes" ]]
  then
    experimental=1
    echo "Auto-detected clpp (experimental) archive; enabling --experimental." >&2
  fi
fi

output_parent="$(dirname -- "$output_dir")"
if [[ ! -d "$output_parent" ]]; then
  echo "error: output parent directory does not exist: $output_parent" >&2
  exit 1
fi

if is_broad_output_dir "$output_dir"; then
  echo "error: refusing broad output directory: $output_dir" >&2
  exit 2
fi

if [[ -n "$target_ordered_chunk_size" && "$ordered" -ne 1 ]]; then
  echo "error: --target-ordered-chunk-size requires --ordered" >&2
  exit 2
fi
if [[ "$print_ordered_chunk_stats" -eq 1 && "$ordered" -ne 1 ]]; then
  echo "error: --print-ordered-chunk-stats requires --ordered" >&2
  exit 2
fi

# Per-invocation binary override composes with the CLP_S_BIN env var already
# honored by resolve_clp_s; the flag wins for this invocation only.
if [[ -n "$clp_s_bin_override" ]]; then
  export CLP_S_BIN="$clp_s_bin_override"
fi
clp_s_bin="$(resolve_clp_s)" || exit $?

cmd=("$clp_s_bin" x)
if [[ "$experimental" -eq 1 ]]; then
  cmd+=(--experimental)
fi
if [[ "$ordered" -eq 1 ]]; then
  cmd+=(--ordered)
fi
if [[ -n "$target_ordered_chunk_size" ]]; then
  cmd+=(--target-ordered-chunk-size "$target_ordered_chunk_size")
fi
if [[ "$print_ordered_chunk_stats" -eq 1 ]]; then
  cmd+=(--print-ordered-chunk-stats)
fi
if [[ -n "$archive_id" ]]; then
  cmd+=(--archive-id "$archive_id")
fi
cmd+=("$archives_dir" "$output_dir")

echo "Archives dir: $input_archives_dir"
if [[ "$archives_dir" != "$input_archives_dir" ]]; then
  echo "Resolved clp-s archive dir: $archives_dir"
fi
echo "Output dir: $output_dir"
printf 'Command:'
printf ' %q' "${cmd[@]}"
echo

if [[ "$dry_run" -eq 1 ]]; then
  exit 0
fi

exec "${cmd[@]}"
