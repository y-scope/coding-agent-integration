#!/usr/bin/env python3
"""
log-shape-report-save - save a finished log-insights report where the user
asked, as Markdown, HTML, PDF, or a page to publish on claude.ai
(log-insights skill, step 10).

The report writer always writes Markdown to /tmp/log-shape-insight-report.md,
and the report check reads that file, so the user's choice of place and format
only matters once the report is final. The skill asks while the writer works
and runs this afterwards.

  --list-formats  Print FORMATS=<what this machine can write> and
                  PDF_ENGINE=<the browser used for PDF, or none>, and exit.
                  The skill offers PDF only when a PDF engine exists.
  --format F      md, html, pdf or artifact; repeatable, or comma-separated.
                  "artifact" writes an HTML fragment (no <html>/<head>/<body>)
                  for the Artifact tool to publish; it goes to /tmp, not to
                  --dest.
  --dest D        Where to save: a directory (existing, or ending in "/") gets
                  log-insights-<name>-<YYYYmmdd-HHMM>.<ext>; anything else is
                  a file name. A .md/.html/.pdf extension on it is replaced by
                  each format's own. "~" is expanded; missing parent
                  directories are created. Default: the current directory.
  --name N        The <name> part of a default file name (default: taken from
                  the report's title, e.g. "cockroach.node1.log").
  --facts F       The facts file whose "Time span" line gives the logs' date
                  range for the header (default: /tmp/log-shape-insight-facts.md).
                  With no file, or a span that is unavailable, the header
                  shows only the generation date.

An existing file is never overwritten: the name gets -2, -3, ... instead.
Prints SAVED_<FORMAT>=<absolute path> per file written. Exit codes: 0 all
written, 1 a format failed (PDF_ERROR=... says why; the others are still
written), 2 input problem.

PDF is printed by a headless Chromium-family browser: $CLP_PDF_BROWSER, then
chromium/chrome/edge on PATH, the macOS app bundles, Playwright's downloaded
Chromium, and on WSL the Windows Chrome or Edge. Nothing is installed.
"""

import argparse
import datetime
import glob
import html
import os
import re
import shutil
import subprocess
import sys
import tempfile

DEFAULT_REPORT = "/tmp/log-shape-insight-report.md"
DEFAULT_FACTS = "/tmp/log-shape-insight-facts.md"
ARTIFACT_PATH = "/tmp/log-shape-insight-report.artifact.html"
EXTENSIONS = {"md": ".md", "html": ".html", "pdf": ".pdf"}
KNOWN_SUFFIXES = (".md", ".markdown", ".html", ".htm", ".pdf")


# --------------------------------------------------------------------------
# Markdown -> HTML (the subset the report writer uses: headings, paragraphs,
# nested lists, GFM tables, fenced code, block quotes, rules, and inline code,
# bold, italic and links).
# --------------------------------------------------------------------------

INLINE_CODE = re.compile(r"(`+)(.+?)\1", re.S)
LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")
BOLD = re.compile(r"\*\*(.+?)\*\*|__(.+?)__")
ITALIC = re.compile(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])|(?<![\w_])_(?!\s)(.+?)(?<!\s)_(?![\w_])")
NUMERIC_CELL = re.compile(r"^[<>~≈]?\s*[\d,]+(\.\d+)?\s*(%|s|ms|x|×)?(\s*\([^)]*\))?$")


def inline(text):
    """Render inline Markdown; code spans are cut out first so nothing inside
    them is interpreted."""
    spans = []

    def stash(m):
        spans.append("<code>" + html.escape(m.group(2).strip() or m.group(2)) + "</code>")
        return f"\x00{len(spans) - 1}\x00"

    text = INLINE_CODE.sub(stash, text)
    text = html.escape(text, quote=False)

    def link(m):
        href = m.group(2)
        if not re.match(r"^(https?:|#|/|\.)", href):
            return m.group(0)
        return f'<a href="{html.escape(href)}">{m.group(1)}</a>'

    text = LINK.sub(link, text)
    text = BOLD.sub(lambda m: f"<strong>{m.group(1) or m.group(2)}</strong>", text)
    text = ITALIC.sub(lambda m: f"<em>{m.group(1) or m.group(2)}</em>", text)
    return re.sub(r"\x00(\d+)\x00", lambda m: spans[int(m.group(1))], text)


def slug(text, used):
    base = re.sub(r"[^a-z0-9]+", "-", re.sub(r"<[^>]+>", "", text).lower()).strip("-") or "section"
    s, n = base, 2
    while s in used:
        s, n = f"{base}-{n}", n + 1
    used.add(s)
    return s


def split_row(line):
    line = line.strip()
    if line.startswith("|"):
        line = line[1:]
    if line.endswith("|") and not line.endswith("\\|"):
        line = line[:-1]
    cells, cur, in_code = [], "", False
    i = 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line) and line[i + 1] == "|":
            cur += "|"
            i += 2
            continue
        if c == "`":
            in_code = not in_code
        if c == "|" and not in_code:
            cells.append(cur.strip())
            cur = ""
        else:
            cur += c
        i += 1
    cells.append(cur.strip())
    return cells


TABLE_SEP = re.compile(r"^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$")
LIST_ITEM = re.compile(r"^(\s*)([-*+]|\d+[.)])\s+(.*)$")
HEADING = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
FENCE = re.compile(r"^(\s*)(```+|~~~+)\s*([\w+-]*)\s*$")


def render_table(lines):
    head = split_row(lines[0])
    aligns = []
    for cell in split_row(lines[1]):
        left, right = cell.startswith(":"), cell.endswith(":")
        aligns.append("center" if left and right else "right" if right else "")
    rows = [split_row(l) for l in lines[2:]]
    out = ['<div class="tablewrap"><table>', "<thead><tr>"]
    for i, cell in enumerate(head):
        cls = ' class="num"' if i < len(aligns) and aligns[i] == "right" else ""
        out.append(f"<th{cls}>{inline(cell)}</th>")
    out.append("</tr></thead><tbody>")
    for row in rows:
        out.append("<tr>")
        for i, cell in enumerate(row):
            numeric = NUMERIC_CELL.match(re.sub(r"\*\*", "", cell)) is not None
            cls = ' class="num"' if numeric or (i < len(aligns) and aligns[i] == "right") else ""
            out.append(f"<td{cls}>{inline(cell)}</td>")
        out.append("</tr>")
    out.append("</tbody></table></div>")
    return "".join(out)


def render_list(items):
    """items: [(indent, marker, text lines)] -> nested <ul>/<ol>."""
    out, stack = [], []  # stack of (indent, tag)

    def open_list(indent, marker):
        tag = "ol" if marker[0].isdigit() else "ul"
        start = ""
        if tag == "ol":
            n = int(re.match(r"\d+", marker).group(0))
            if n != 1:
                start = f' start="{n}"'
        out.append(f"<{tag}{start}>")
        stack.append((indent, tag))

    for indent, marker, body in items:
        if not stack:
            open_list(indent, marker)
        elif indent > stack[-1][0]:
            out[-1] = out[-1].removesuffix("</li>")
            open_list(indent, marker)
        else:
            while len(stack) > 1 and indent < stack[-1][0]:
                _, tag = stack.pop()
                out.append(f"</{tag}></li>")
        out.append(f"<li>{render_blocks(body, nested=True)}</li>")
    while stack:
        _, tag = stack.pop()
        out.append(f"</{tag}>" + ("</li>" if stack else ""))
    return "".join(out)


def render_blocks(lines, nested=False, toc=None, used=None):
    out, i, para = [], 0, []
    used = used if used is not None else set()

    def flush():
        if para:
            text = inline(" ".join(l.strip() for l in para))
            out.append(text if nested and not out else f"<p>{text}</p>")
            para.clear()

    while i < len(lines):
        line = lines[i]
        if not line.strip():
            flush()
            i += 1
            continue
        m = FENCE.match(line)
        if m:
            flush()
            indent, fence = len(m.group(1)), m.group(2)
            body, i = [], i + 1
            while i < len(lines) and not lines[i].strip().startswith(fence):
                body.append(lines[i][indent:] if lines[i][:indent].strip() == "" else lines[i])
                i += 1
            i += 1
            out.append('<div class="codewrap"><pre><code>' + html.escape("\n".join(body)) + "</code></pre></div>")
            continue
        m = HEADING.match(line)
        if m and not nested:
            flush()
            level, text = len(m.group(1)), inline(m.group(2))
            hid = slug(text, used)
            if toc is not None and level == 2:
                toc.append((hid, text))
            out.append(f'<h{level} id="{hid}">{text}</h{level}>')
            i += 1
            continue
        if re.match(r"^\s{0,3}([-*_])(\s*\1){2,}\s*$", line):
            flush()
            out.append("<hr>")
            i += 1
            continue
        if "|" in line and i + 1 < len(lines) and TABLE_SEP.match(lines[i + 1]):
            flush()
            j = i + 2
            while j < len(lines) and "|" in lines[j] and lines[j].strip():
                j += 1
            out.append(render_table(lines[i:j]))
            i = j
            continue
        if line.lstrip().startswith(">"):
            flush()
            quote = []
            while i < len(lines) and lines[i].lstrip().startswith(">"):
                quote.append(re.sub(r"^\s*>\s?", "", lines[i]))
                i += 1
            out.append("<blockquote>" + render_blocks(quote, used=used) + "</blockquote>")
            continue
        m = LIST_ITEM.match(line)
        if m:
            flush()
            items = []
            base = len(m.group(1))
            while i < len(lines):
                m = LIST_ITEM.match(lines[i])
                if m and len(m.group(1)) >= base:
                    indent = len(m.group(1))
                    body_indent = indent + len(m.group(2)) + 1
                    body = [m.group(3)]
                    i += 1
                    # Continuation lines, and fenced code that belongs to the item.
                    while i < len(lines):
                        nxt = lines[i]
                        if not nxt.strip():
                            if i + 1 < len(lines) and len(lines[i + 1]) - len(lines[i + 1].lstrip()) >= body_indent and not LIST_ITEM.match(lines[i + 1]):
                                body.append("")
                                i += 1
                                continue
                            break
                        lead = len(nxt) - len(nxt.lstrip())
                        if LIST_ITEM.match(nxt) or lead < body_indent and not para_continuation(nxt):
                            break
                        body.append(nxt[body_indent:] if lead >= body_indent else nxt.strip())
                        i += 1
                    items.append((indent, m.group(2), body))
                elif not lines[i].strip() and i + 1 < len(lines) and LIST_ITEM.match(lines[i + 1]) and len(LIST_ITEM.match(lines[i + 1]).group(1)) >= base:
                    i += 1
                else:
                    break
            out.append(render_list(items))
            continue
        para.append(line)
        i += 1
    flush()
    return "".join(out)


def para_continuation(line):
    """A lazily indented line that continues the item's paragraph."""
    return not (HEADING.match(line) or FENCE.match(line) or line.lstrip().startswith(("|", ">")))


# --------------------------------------------------------------------------
# Page
# --------------------------------------------------------------------------

