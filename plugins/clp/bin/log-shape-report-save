def build_page(markdown, stamps, fragment=False, fonts=True):
    lines = markdown.splitlines()
    title = "Log Insights Report"
    if lines and HEADING.match(lines[0]) and HEADING.match(lines[0]).group(1) == "#":
        title = HEADING.match(lines[0]).group(2)
        lines = lines[1:]
    toc = []
    body = render_blocks(lines, toc=toc)
    nav = ""
    if len(toc) > 2:
        nav = '<nav aria-label="Sections">' + "".join(
            f'<a href="#{hid}">{re.sub(r"<[^>]+>", "", text)}</a>' for hid, text in toc) + "</nav>"
    page_title = "Log Insights Report"
    subject = title.split(":", 1)[1].strip() if ":" in title else ""
    if subject:
        page_title = f"{subject} log insights"
    content = (
        f'<div class="page"><header><div class="eyebrow">CLP · log-insights</div>'
        f"<h1>{inline(title)}</h1>"
        '<div class="meta">' + "".join(f"<span>{html.escape(k)}: {html.escape(v)}</span>" for k, v in stamps) + "</div>"
        f"{nav}</header><article>{body}</article>"
        f"<footer>Written by the CLP plugin's log-insights skill from queries against the archive; "
        f"the Query Log lists every one.</footer></div>"
    )
    head = f"<title>{html.escape(page_title)}</title>" + (FONTS if fonts else "") + f"<style>{CSS}</style>"
    if fragment:
        return head + content
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
            f'<meta name="viewport" content="width=device-width,initial-scale=1">{head}</head>'
            f"<body>{content}</body></html>")


# --------------------------------------------------------------------------
# PDF
# --------------------------------------------------------------------------

def is_wsl():
    try:
        with open("/proc/version") as f:
            return "microsoft" in f.read().lower()
    except OSError:
        return False


def find_pdf_engine():
    """(path, needs_windows_paths) of a Chromium-family browser, or None."""
    env = os.environ.get("CLP_PDF_BROWSER")
    if env:
        path = shutil.which(env) or env
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path, path.lower().endswith(".exe")
    for name in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable",
                 "chrome", "microsoft-edge", "microsoft-edge-stable", "msedge"):
        path = shutil.which(name)
        if path:
            return path, False
    for path in ("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
                 "/Applications/Chromium.app/Contents/MacOS/Chromium",
                 "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"):
        if os.path.isfile(path):
            return path, False
    home = os.path.expanduser("~")
    for root in (os.path.join(home, ".cache/ms-playwright"), os.path.join(home, "Library/Caches/ms-playwright")):
        for pattern in ("chromium_headless_shell-*/chrome-*/headless_shell",
                        "chromium-*/chrome-linux*/chrome",
                        "chromium-*/chrome-mac*/Chromium.app/Contents/MacOS/Chromium",
                        "chromium-*/chrome-mac*/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"):
            found = sorted(glob.glob(os.path.join(root, pattern)), reverse=True)
            if found:
                return found[0], False
    if is_wsl() and shutil.which("wslpath"):
        for path in ("/mnt/c/Program Files/Google/Chrome/Application/chrome.exe",
                     "/mnt/c/Program Files (x86)/Google/Chrome/Application/chrome.exe",
                     "/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe",
                     "/mnt/c/Program Files/Microsoft/Edge/Application/msedge.exe"):
            if os.path.isfile(path):
                return path, True
    return None


def to_windows(path):
    return subprocess.run(["wslpath", "-w", path], capture_output=True, text=True, check=True).stdout.strip()


def write_pdf(page_html, out_path, engine):
    browser, windows = engine
    # A Windows browser cannot read the WSL /tmp reliably, so stage next to the output.
    stage_dir = os.path.dirname(out_path) if windows else None
    with tempfile.TemporaryDirectory(dir=stage_dir, prefix=".log-insights-pdf-") as tmp:
        src = os.path.join(tmp, "report.html")
        pdf = os.path.join(tmp, "report.pdf")
        with open(src, "w", encoding="utf-8") as f:
            f.write(page_html)
        if windows:
            url = "file:///" + to_windows(src).replace("\\", "/")
            target = to_windows(pdf)
        else:
            url = "file://" + src
            target = pdf
        cmd = [browser, "--headless", "--disable-gpu", "--no-sandbox", "--no-first-run",
               "--no-pdf-header-footer", "--print-to-pdf-no-header",
               f"--user-data-dir={to_windows(tmp) if windows else tmp}",
               f"--print-to-pdf={target}", url]
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        except subprocess.TimeoutExpired:
            return "the browser did not finish printing within 120 s"
        if not os.path.isfile(pdf) or os.path.getsize(pdf) == 0:
            err = (proc.stderr or proc.stdout).strip().splitlines()
            return f"{os.path.basename(browser)} exited {proc.returncode} without writing a PDF" + (
                f": {err[-1]}" if err else "")
        shutil.move(pdf, out_path)
    return None


# --------------------------------------------------------------------------
# Destination
# --------------------------------------------------------------------------

def time_span(facts_path):
    """The logs' date range from the facts file's "Time span" line, or None
    when there is no facts file or the span is unavailable."""
    try:
        with open(facts_path, encoding="utf-8") as f:
            for line in f:
                m = re.match(r"^- Time span: (.+? to .+?) \(([^)]+)\)", line)
                if m:
                    return f"{m.group(1)} ({m.group(2)})"
    except OSError:
        pass
    return None


def stamp_markdown(markdown, stamps):
    """The report with the header's dates under its title, as the HTML shows."""
    line = " · ".join(f"{k}: {v}" for k, v in stamps)
    lines = markdown.splitlines(keepends=True)
    if lines and HEADING.match(lines[0]) and HEADING.match(lines[0]).group(1) == "#":
        return lines[0] + "\n" + line + "\n" + "".join(lines[1:])
    return line + "\n\n" + markdown


def default_name(markdown, name):
    if not name:
        first = markdown.lstrip().splitlines()[0] if markdown.strip() else ""
        m = HEADING.match(first)
        title = m.group(2) if m else ""
        name = title.split(":", 1)[1] if ":" in title else ""
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", name.strip()).strip("-.") or "report"
    return f"log-insights-{name}-{datetime.datetime.now():%Y%m%d-%H%M}"


def unique(path):
    if not os.path.exists(path):
        return path
    stem, ext = os.path.splitext(path)
    n = 2
    while os.path.exists(f"{stem}-{n}{ext}"):
        n += 1
    return f"{stem}-{n}{ext}"


def resolve_stem(dest, markdown, name):
    """Absolute path without extension for the saved files."""
    raw = dest if dest else os.getcwd()
    path = os.path.abspath(os.path.expanduser(raw))
    if raw.endswith(("/", os.sep)) or os.path.isdir(path):
        return os.path.join(path, default_name(markdown, name))
    if path.lower().endswith(KNOWN_SUFFIXES):
        path = os.path.splitext(path)[0]
    return path


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("report", nargs="?", default=DEFAULT_REPORT)
    ap.add_argument("--format", action="append", default=[])
    ap.add_argument("--dest")
    ap.add_argument("--name")
    ap.add_argument("--facts", default=DEFAULT_FACTS)
    ap.add_argument("--list-formats", action="store_true")
    args = ap.parse_args()

    engine = find_pdf_engine()
    if args.list_formats:
        print("FORMATS=" + ",".join(["md", "html"] + (["pdf"] if engine else [])))
        print("PDF_ENGINE=" + (engine[0] if engine else "none"))
        return 0

    formats = []
    for f in args.format:
        for part in f.split(","):
            part = part.strip().lower()
            part = {"markdown": "md", "htm": "html"}.get(part, part)
            if part and part not in formats:
                formats.append(part)
    bad = [f for f in formats if f not in ("md", "html", "pdf", "artifact")]
    if not formats or bad:
        print(f"ERROR: --format must be md, html, pdf or artifact (got {', '.join(bad) or 'nothing'})", file=sys.stderr)
        return 2
    try:
        with open(args.report, encoding="utf-8") as f:
            markdown = f.read()
    except OSError as e:
        print(f"ERROR: cannot read the report: {e}", file=sys.stderr)
        return 2
    if not markdown.strip():
        print(f"ERROR: the report {args.report} is empty", file=sys.stderr)
        return 2

    now = datetime.datetime.now().astimezone()
    stamps = []
    span = time_span(args.facts)
    if span:
        stamps.append(("Logs", span))
    stamps.append(("Generated", f"{now:%Y-%m-%d %H:%M %Z}".strip()))
    stem = None
    if any(f in EXTENSIONS for f in formats):
        stem = resolve_stem(args.dest, markdown, args.name)
        try:
            os.makedirs(os.path.dirname(stem), exist_ok=True)
        except OSError as e:
            print(f"ERROR: cannot create {os.path.dirname(stem)}: {e}", file=sys.stderr)
            return 2

    status = 0
    for fmt in formats:
        if fmt == "artifact":
            with open(ARTIFACT_PATH, "w", encoding="utf-8") as f:
                f.write(build_page(markdown, stamps, fragment=True))
            print(f"SAVED_ARTIFACT={ARTIFACT_PATH}")
            continue
        out = unique(stem + EXTENSIONS[fmt])
        try:
            if fmt == "md":
                with open(out, "w", encoding="utf-8") as f:
                    f.write(stamp_markdown(markdown, stamps))
            elif fmt == "html":
                with open(out, "w", encoding="utf-8") as f:
                    f.write(build_page(markdown, stamps))
            else:
                if not engine:
                    print("PDF_ERROR=no Chromium-family browser found (Chrome, Chromium or Edge); "
                          "set CLP_PDF_BROWSER to one to enable PDF")
                    status = 1
                    continue
                # No web fonts: the headless print must not depend on the network.
                err = write_pdf(build_page(markdown, stamps, fonts=False), out, engine)
                if err:
                    print(f"PDF_ERROR={err}")
                    status = 1
                    continue
        except OSError as e:
            print(f"ERROR: cannot write {out}: {e}", file=sys.stderr)
            status = 1
            continue
        print(f"SAVED_{fmt.upper()}={out}")
    return status


if __name__ == "__main__":
    sys.exit(main())
